<Window x:Class="QC_Management.ReivewReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QC_Management" 
        xmlns:winforms="clr-namespace:Microsoft.Reporting.WinForms;assembly=Microsoft.ReportViewer.WinForms"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Title="ReportView" Height="450" Width="800" Loaded="Window_Loaded">
    <DockPanel>
        <!-- Toolbar: Export PDF + Close -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button x:Name="BtnExportPdf" Content="Xuất PDF" Width="100" Margin="0,0,8,0" Click="BtnExportPdf_Click"/>
            <Button x:Name="BtnClose" Content="Đóng" Width="80" Click="BtnClose_Click"/>
        </StackPanel>

        <WindowsFormsHost>
            <winforms:ReportViewer x:Name="reportViewer"/>
        </WindowsFormsHost>
    </DockPanel>
</Window>
