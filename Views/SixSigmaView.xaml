<UserControl x:Class="QC_Management.Views.SixSigmaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             DataContext="{StaticResource SixSigmaVM}"
             d:DesignHeight="650"
             d:DesignWidth="1200"
             MinHeight="500"
             MinWidth="900">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Quản lý Six Sigma"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <WrapPanel Grid.Row="1"
                   VerticalAlignment="Center"
                   Margin="0,0,0,12">

            <ComboBox Width="220"
                      Margin="0,0,8,0"
                      ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      materialDesign:HintAssist.Hint="Thiết bị"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

            <ComboBox Width="260"
                      Margin="0,0,8,0"
                      ItemsSource="{Binding Tests}"
                      SelectedItem="{Binding SelectedTest, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      materialDesign:HintAssist.Hint="Xét nghiệm định lượng"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

            <DatePicker Width="150"
                        Margin="0,0,8,0"
                        SelectedDate="{Binding PeriodStart, Mode=TwoWay}"
                        materialDesign:HintAssist.Hint="Từ ngày"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>

            <DatePicker Width="150"
                        Margin="0,0,8,0"
                        SelectedDate="{Binding PeriodEnd, Mode=TwoWay}"
                        materialDesign:HintAssist.Hint="Đến ngày"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
        </WrapPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">

            <Button Content="Tính Six Sigma"
                    Width="125"
                    Margin="0,0,8,0"
                    Command="{Binding CalculateCommand}"/>

            <Button Content="Tải kết quả đã lưu"
                    Width="145"
                    Margin="0,0,8,0"
                    Command="{Binding LoadSavedCommand}"/>

            <Button Content="Lưu kết quả"
                    Width="110"
                    Margin="0,0,8,0"
                    Command="{Binding SaveCommand}"/>

            <Button Content="Làm mới"
                    Width="90"
                    Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="{Binding SummaryText}"
                   Margin="0,0,0,8"/>

        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding Metrics}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Thiết bị"
                                    Binding="{Binding DeviceName}"
                                    Width="1.3*"/>

                <DataGridTextColumn Header="Xét nghiệm"
                                    Binding="{Binding TestName}"
                                    Width="1.5*"/>

                <DataGridTextColumn Header="Level"
                                    Binding="{Binding LevelText}"
                                    Width="0.7*"/>

                <DataGridTextColumn Header="TEa"
                                    Binding="{Binding TeaText}"
                                    Width="0.8*"/>

                <DataGridTextColumn Header="Bias"
                                    Binding="{Binding BiasText}"
                                    Width="0.8*"/>

                <DataGridTextColumn Header="CV"
                                    Binding="{Binding CvText}"
                                    Width="0.8*"/>

                <DataGridTextColumn Header="Sigma"
                                    Binding="{Binding SigmaText}"
                                    Width="0.8*"/>

                <DataGridTextColumn Header="QGI"
                                    Binding="{Binding QgiText}"
                                    Width="0.8*"/>

                <DataGridTextColumn Header="N Bias"
                                    Binding="{Binding Metric.BiasN}"
                                    Width="0.7*"/>

                <DataGridTextColumn Header="N CV"
                                    Binding="{Binding Metric.CvN}"
                                    Width="0.7*"/>

                <DataGridTextColumn Header="Đánh giá"
                                    Binding="{Binding Metric.Grade}"
                                    Width="1.4*"/>

                <DataGridTextColumn Header="Khoảng thời gian"
                                    Binding="{Binding PeriodText}"
                                    Width="1.5*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>