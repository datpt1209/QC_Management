<UserControl x:Class="QC_Management.Views.CAL_DetailView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
 xmlns:local="clr-namespace:QC_Management.Views"
 mc:Ignorable="d" 
 xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
 TextElement.Foreground="{DynamicResource MaterialDesignBody}"
 TextElement.FontWeight="Regular"
 TextElement.FontSize="13"
 TextOptions.TextFormattingMode="Ideal"
 TextOptions.TextRenderingMode="Auto"
 Background="{DynamicResource MaterialDesignPaper}"
 FontFamily="{DynamicResource MaterialDesignFont}"
 DataContext="{StaticResource CalDetailVM}"
 Name="Objectview" d:DesignHeight="600" d:DesignWidth="800">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}">
            </i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <!--các element binding từ selected item-->
            <materialDesign:Card Grid.Row="0" Margin="5">
                <WrapPanel Margin="5">
                    <ComboBox
                        DisplayMemberPath="Name"
                        Margin="5"
                        ItemsSource="{Binding DeviceList}"
                        SelectedItem="{Binding SelectedDevice}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Deivce"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        IsEditable="True" 
                        Width="135" Height="50">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding DeviceSelectionChangedCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <ComboBox
                        Margin="5"
                        ItemsSource="{Binding CalTypeList}"
                        SelectedItem="{Binding SelectedCalType}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="CAL Type"
                        DisplayMemberPath="CalTypeName"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        IsEditable="True" Width="135" 
                        Height="50">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding CalTypeSelectionChangedCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        
                    </ComboBox>

                    <ComboBox
                        Margin="5"
                        ItemsSource="{Binding CalInfoList}"
                        SelectedItem="{Binding SelectedCalInfo}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="CAL Infor"
                        DisplayMemberPath="CalLot"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        IsEditable="True" Width="135" 
                        Height="50">


                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding CalInforSelectionChangedCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                    </ComboBox>

                    <ComboBox
                        Margin="5"
                        ItemsSource="{Binding TestList}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedTest, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Xét nghiệm"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        IsEditable="True"
                        Width="135" Height="50">

                    </ComboBox>
                    <TextBox
                        Margin="5"
                        VerticalAlignment="Center"   
                        materialDesign:HintAssist.Hint="Level"  
                        Text="{Binding SelectedLevel}"
                        AcceptsReturn="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        TextWrapping="Wrap" 
                        Width="135" Height="50" />
                    <TextBox
                        Margin="5"
                        VerticalAlignment="Center" 
                        materialDesign:HintAssist.Hint="Min"
                        Text="{Binding Min}"
                        AcceptsReturn="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        TextWrapping="Wrap"
                        Width="135" Height="50" />

                    <TextBox
                        Margin="5"
                        VerticalAlignment="Center" 
                        materialDesign:HintAssist.Hint="Max"
                        Text="{Binding Max}"
                        AcceptsReturn="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        TextWrapping="Wrap" Width="135" Height="50"/>
                    <CheckBox
                        Content="Kích hoạt"
                        IsChecked="{Binding CALIsEnable}"/>

                </WrapPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="1" Margin="5">
                <WrapPanel>
                    <Button Command="{Binding AddCommand}" Content="Thêm" Margin="5" Width="100"></Button>
                    <Button Command="{Binding DeleteCommand}" Content="Xóa" Margin="5" Width="100"></Button>
                    <Button Command="{Binding EditCommand}" Content="Sửa" Margin="5" Width="100"></Button>
                </WrapPanel>

            </materialDesign:Card>

            <materialDesign:Card Grid.Row="2" Margin="5" VerticalAlignment="Stretch">
                <ListView ItemsSource="{Binding List,Mode=TwoWay}" SelectedItem="{Binding SelectedItem}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Test" Width="100" DisplayMemberBinding="{Binding IdTestNavigation.Name}"/>
                            <GridViewColumn Header="Loại Cal" Width="100" DisplayMemberBinding="{Binding IdCalInforNavigation.IdCalTypeNavigation.CalTypeName}"/>
                            <GridViewColumn Header="LOT Cal" Width="100" DisplayMemberBinding="{Binding IdCalInforNavigation.CalLot}"/>
                            <GridViewColumn Header="Level" Width="80" DisplayMemberBinding="{Binding Level}"/>
                            <GridViewColumn Header="MinValue" Width="80" DisplayMemberBinding="{Binding MinValue}"/>
                            <GridViewColumn Header="MaxValuue" Width="80" DisplayMemberBinding="{Binding MaxValue}"/>
                            <GridViewColumn Header="Active" Width="50" DisplayMemberBinding="{Binding Status}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
