<UserControl x:Class="QC_Management.Views.ViewResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}"
             DataContext="{StaticResource ViewResultVM}"
             Name="Objectview" d:DesignHeight="600" d:DesignWidth="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}">
            </i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Margin="0,0,0,-14">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <!--các element binding từ selected item-->
            <materialDesign:Card Grid.Row="0" Margin="5">
                <WrapPanel Margin="5">

                    <DatePicker          
                         Margin="5" 
                            SelectedDate="{Binding SelectedDate, UpdateSourceTrigger=PropertyChanged}"                             
                            materialDesign:HintAssist.Hint="Ngày thực hiện"                              
                            materialDesign:TextFieldAssist.HasClearButton="True" 
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" Width="140" Height="50">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectedDateChanged">
                                <i:InvokeCommandAction Command="{Binding DateChangedCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </DatePicker>
                    <ComboBox 
                        Margin="5"
                        ItemsSource="{Binding DeviceList}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Thiết bị"
                        materialDesign:HintAssist.HintOpacity=".26"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        IsEditable="True" VerticalAlignment="Top" 
                        Width="189" Height="50">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding DeviceSelectionChangedCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                    </ComboBox>
                    <ComboBox  
                        Margin="5"
                        ItemsSource="{Binding LevelList}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Level"
                        materialDesign:HintAssist.HintOpacity=".26"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        IsEditable="True" VerticalAlignment="Top" Width="189" Height="50">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding LevelChangedCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <ComboBox 
                        Margin="5"
                        ItemsSource="{Binding IndexList}"
                        SelectedItem="{Binding SelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Lần QC"
                        materialDesign:HintAssist.IsFloating="True"
                        materialDesign:HintAssist.HintOpacity=".26"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        IsEditable="True" VerticalAlignment="Top" Width="100" Height="50"/>

                </WrapPanel>
            </materialDesign:Card>
            <Grid Grid.Row="1">
                <Grid Grid.Column="0">
                    <materialDesign:Card  Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding ViewCommand}" Content="Xem" Margin="5" Width="100"/>
                            <Button Command="{Binding PrintCommand}" Content="In"  Margin="5" Width="100"/>
                            <Button Command="{Binding EditCommand}" Background="Orange"  
                                    Margin="5" Content="Cập nhật" 
                                    Width="100"/>
                            <Button Command="{Binding DeleteCommand}" Background="OrangeRed"  
                                    Margin="5" Content="Xóa" 
                                    Width="100"/>
                            <Button Command="{Binding AddCommand}" Background="Green"  
                                    Margin="5" Content="Thêm" 
                                    Width="100"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </Grid>

            <materialDesign:Card Grid.Row="2" Margin="5" VerticalAlignment="Stretch">
                <DataGrid Name="input" ItemsSource="{Binding ResultViewList, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          SelectedItem="{Binding SelectedItem, Mode=OneWayToSource}"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Xét nghiệm" Binding="{Binding IdTestNavigation.Name ,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                        <DataGridTextColumn Header="LOT QC" Binding="{Binding IdControlDetailNavigation.Lot,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Qualitative" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding IdControlDetailNavigation.QualitativeMean,UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResultType}" Value="1">
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Mean" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding IdControlDetailNavigation.CurMean ,UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResultType ,UpdateSourceTrigger=PropertyChanged}" Value="2">
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="SD" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding IdControlDetailNavigation.CurSd,UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResultType,UpdateSourceTrigger=PropertyChanged}" Value="2">
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                
                        <DataGridTemplateColumn Header="Kết quả" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding TempResult, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Foreground" Value="Green" />
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <!--<Setter Property="HorizontalAlignment" Value="Center"/>-->
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOutRange}" Value="True">
                                                        <Setter Property="Foreground" Value="Red" />
                                                        <Setter Property="Background" Value="Yellow" />
                                                        <!--Thay đổi màu nền nếu ngoài 3 SD-->
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--<DataGridTemplateColumn Header="Định tính" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding QualitativeResult, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Foreground" Value="Green" />
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="IsEnabled" Value="false"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResultType}" Value="1">
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOutRange}" Value="True">
                                                        <Setter Property="Foreground" Value="Red" />
                                                        <Setter Property="Background" Value="Yellow" />
                                                        --><!--Thay đổi màu nền nếu ngoài 3 SD--><!--
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>-->
                        <DataGridTextColumn Header="Người thực hiện" IsReadOnly="True" Binding="{Binding IdUserNavigation.DisplayName,UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Ngày thực hiện" IsReadOnly="True" Binding="{Binding DateRun.Date,UpdateSourceTrigger=PropertyChanged, StringFormat=dd/MM/yyyy}"/>
                        <DataGridTextColumn Header="Giờ thực hiện" IsReadOnly="True" Binding="{Binding Time, Converter={StaticResource TimeSpanConverter}}"/>
                        <DataGridTextColumn Header="Ghi chú"  Binding="{Binding Comment,UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Lỗi Westgard"  Binding="{Binding WestgardRule,UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTemplateColumn Header="Actions">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button 
                                        Content="Delete" 
                                        Command="{Binding DataContext.DeleteOneTestCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock TextDecorations="Underline">
                                                    <ContentPresenter />
                                                </TextBlock>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Foreground" Value="Blue" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="true">
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>