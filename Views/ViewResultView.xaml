<UserControl x:Class="QC_Management.Views.ViewResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}"
             DataContext="{StaticResource ViewResultVM}"
             Name="Objectview" d:DesignHeight="600" d:DesignWidth="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}">
            </i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Margin="0,0,0,-14">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <!--các element binding từ selected item-->
            <materialDesign:Card Grid.Row="0" Margin="5">
                <WrapPanel Margin="0 0 0 10">

                    <DatePicker          
                         Margin="5, 0, 0 , 0" 
                            SelectedDate="{Binding SelectedDate, UpdateSourceTrigger=PropertyChanged}"                             
                            materialDesign:HintAssist.Hint="Ngày thực hiện"                              
                            materialDesign:TextFieldAssist.HasClearButton="True"                               
                            Style="{StaticResource MaterialDesignFloatingHintDatePicker}" Width="128" Height="41">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectedDateChanged">
                                <i:InvokeCommandAction Command="{Binding DateChangedCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                    </DatePicker>

                    <ComboBox 
                        Margin="5 5 15 -14"
                        ItemsSource="{Binding DeviceList}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Thiết bị"
                        materialDesign:HintAssist.HintOpacity=".26"
                        IsEditable="True" VerticalAlignment="Top" Width="189" Height="37"/>
                    <ComboBox  
                        Margin="5 5 15 5"
                        ItemsSource="{Binding LevelList}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Level"
                        materialDesign:HintAssist.HintOpacity=".26"
                        IsEditable="True" VerticalAlignment="Top" Width="189" Height="37">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding LevelChangedCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <ComboBox 
                        Margin="5 5 15 5"
                        ItemsSource="{Binding IndexList}"
                        SelectedItem="{Binding SelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Lần QC"
                        materialDesign:HintAssist.IsFloating="True"
                        materialDesign:HintAssist.HintOpacity=".26"
                        IsEditable="True" VerticalAlignment="Top" Width="100" Height="37"/>

                </WrapPanel>
            </materialDesign:Card>
            <Grid Grid.Row="1">
                <Grid Grid.Column="0">
                    <materialDesign:Card  Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding ViewCommand}" Content="Xem" Margin="5" Width="100"/>
                            <Button Command="{Binding PrintCommand}" Content="In"  Margin="5" Width="100"/>
                            <Button Command="{Binding EditCommand}" Background="Orange"  
                                    Margin="5" Content="Sửa" 
                                    Width="100"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </Grid>

            <materialDesign:Card  Grid.Row="2" Margin="5" VerticalAlignment="Stretch">
                <DataGrid Name="input" ItemsSource="{Binding ResultViewList}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          SelectedItem="{Binding SelectedItem, Mode=OneWayToSource}"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Test" Binding="{Binding IdTestNavigation.Name}" IsReadOnly="True" />
                        <DataGridTextColumn Header="LOT QC" Binding="{Binding IdControlDetailNavigation.IdControlInfoNavigation.Lot }" IsReadOnly="True" />
                        <DataGridTextColumn Header="Mean" Binding="{Binding IdControlDetailNavigation.MeanNsx }" IsReadOnly="True" />
                        <DataGridTextColumn Header="SD" Binding="{Binding IdControlDetailNavigation.SdNsx }" IsReadOnly="True" />
                        <DataGridTextColumn Header="Result" IsReadOnly="False" Binding="{Binding Result1}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="Green" />
                                    <!-- Màu mặc định -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result1}" Value="">
                                            <Setter Property="Foreground" Value="Red" />
                                            <!-- Thay đổi màu nền nếu ngoài 2 SD -->
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Người thực hiện" IsReadOnly="True" Binding="{Binding IdUserNavigation.DisplayName}"/>
                        <DataGridTextColumn Header="Ngày thực hiện" IsReadOnly="True" Binding="{Binding DateRun.Date, StringFormat=dd/MM/yyyy}"/>
                        <DataGridTextColumn Header="Giờ thực hiện" IsReadOnly="True" Binding="{Binding Time, Converter={StaticResource TimeSpanConverter}}"/>
                        <DataGridTextColumn Header="Lỗi Westgard"  Binding="{Binding WestgardRule}"/>
                        <DataGridTextColumn Header="Ghi chú"  Binding="{Binding Comment}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>