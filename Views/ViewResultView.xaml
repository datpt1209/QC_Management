<UserControl x:Class="QC_Management.Views.ViewResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}"
             DataContext="{StaticResource ViewResultVM}"
             Name="Objectview" d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <SolidColorBrush x:Key="RowEvenBrush" Color="#FFF7F7F8"/>
        <SolidColorBrush x:Key="RowOddBrush" Color="White"/>
        <Style x:Key="EditToggleButtonStyle" TargetType="Button">
            <Setter Property="IsEnabled" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- Filters -->
            <RowDefinition Height="*"/>      <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header: title + primary actions -->
        <Border Grid.Row="0" CornerRadius="10" Height="70" Background="#FF1F2937" Padding="12" Margin="5">
            <DockPanel>
                <TextBlock Text="Xem kết quả" Foreground="White" FontSize="20" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" >
                    <Button Content="In" Width="80" Command="{Binding PrintCommand}" Margin="5,0,5,0" />
                    <Button Content="Thêm" Width="80" Command="{Binding AddCommand}" Margin="5,0,5,0" Background="#2E7D32" Foreground="White"/>
                    <Button Margin="5,0,5,0" Command="{Binding DeleteCommand}" Content="Xóa" Background="OrangeRed" Width="80"/>
                    <!-- Sửa button: disabled when IsEditing == true -->
                    <Button Command="{Binding EnableEditCommand}" Content="Sửa" Margin="5,0,5,0" Width="80" Style="{StaticResource EditToggleButtonStyle}" />
                    <!-- Update (save) is enabled only while editing -->
                    <Button Command="{Binding EditCommand}" Background="Orange" Margin="5,0,5,0" Content="Cập nhật" Width="90" IsEnabled="{Binding IsEditing}"/>
                    <Button Command="{Binding CancelEditCommand}" Background="LightGray" Margin="5,0,5,0" Content="Hủy" Width="80" IsEnabled="{Binding IsEditing}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Filters: types, date, device, level, index -->
        <Border Grid.Row="1" 
                CornerRadius="10" 
                Background="White"
                Padding="10" Margin="5,0,5,5" 
                BorderBrush="#FFE0E6EE"
                BorderThickness="1">
            <WrapPanel Margin="5">
                <ComboBox Margin="5"
                          ItemsSource="{Binding ResultTypes}"
                          SelectedItem="{Binding SelectedResultType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          materialDesign:HintAssist.Hint="Loại kết quả"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Width="150" Height="50"
                          Background="{Binding SelectedResultType, Converter={StaticResource SelectedTypeToBackgroundConverter}}"/>

                <DatePicker Margin="5" 
                            SelectedDate="{Binding SelectedDate, UpdateSourceTrigger=PropertyChanged}"                             
                            materialDesign:HintAssist.Hint="Ngày thực hiện"                              
                            materialDesign:TextFieldAssist.HasClearButton="True" 
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            Width="140" Height="50">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectedDateChanged">
                            <i:InvokeCommandAction Command="{Binding DateChangedCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </DatePicker>

                <ComboBox Margin="5"
                          ItemsSource="{Binding DeviceList}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          materialDesign:ComboBoxAssist.MaxLength="2"
                          materialDesign:HintAssist.Hint="Thiết bị"
                          materialDesign:HintAssist.HintOpacity=".26"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          IsEditable="True" VerticalAlignment="Top" Width="189" Height="50">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding DeviceSelectionChangedCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ComboBox>

                <ComboBox Margin="5"
                          ItemsSource="{Binding LevelList}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          materialDesign:ComboBoxAssist.MaxLength="2"
                          materialDesign:HintAssist.Hint="Level"
                          materialDesign:HintAssist.HintOpacity=".26"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          IsEditable="True" VerticalAlignment="Top" Width="189" Height="50"
                          Visibility="{Binding Visibility1, UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding LevelChangedCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ComboBox>

                <ComboBox Margin="5"
                          ItemsSource="{Binding IndexList}"
                          SelectedItem="{Binding SelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          materialDesign:ComboBoxAssist.MaxLength="2"
                          materialDesign:HintAssist.Hint="Lần QC"
                          materialDesign:HintAssist.IsFloating="True"
                          materialDesign:HintAssist.HintOpacity=".26"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          IsEditable="True" VerticalAlignment="Top" Width="100" Height="50"
                          Visibility="{Binding Visibility1, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Content="Lọc" Width="100" Margin="4" Background="#1976D2" Foreground="White" Command="{Binding ViewCommand}"/>
                <Button Content="Bỏ lọc" Width="100" Margin="4" Background="#D32F2F" Foreground="White" Command="{Binding LoadedCommand}"/>
            </WrapPanel>
        </Border>

        <!-- Content: results cards with consistent style -->

        <Border Grid.Row="2" 
        CornerRadius="10" 
        Background="White"
        Padding="10" Margin="5,0,5,5"  
        BorderBrush="#FFE0E6EE"
        BorderThickness="1">
            <Grid>
                <!-- QC Results grid card -->
                <materialDesign:Card Grid.Row="1"
                         Visibility="{Binding Visibility1}">
                <DataGrid ItemsSource="{Binding ResultViewCollection}"
                  AutoGenerateColumns="False"
                  IsReadOnly="{Binding IsGridReadOnly}"
                  SelectedItem="{Binding SelectedItem, Mode=OneWayToSource}"
                  CanUserAddRows="False"
                  CanUserResizeColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  ColumnWidth="*"
                  RowBackground="{StaticResource RowOddBrush}"
                  AlternatingRowBackground="{StaticResource RowEvenBrush}"
                  GridLinesVisibility="None"
                  BorderThickness="0"
                  HorizontalGridLinesBrush="Transparent"
                  VerticalGridLinesBrush="Transparent"
                  CellEditEnding="DataGrid_CellEditEnding"
                  RowEditEnding="DataGrid_RowEditEnding">

                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter Property="Opacity" Value="0.65"/>
                                        <Setter Property="Background" Value="#FFF7F7F8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>

                        <DataGrid.Resources>
                            <DataTemplate x:Key="WrappedHeaderTemplate">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                                           Margin="4,2" FontWeight="SemiBold" />
                            </DataTemplate>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FFF3F6F9"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="ContentTemplate" Value="{StaticResource WrappedHeaderTemplate}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                            
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Xét nghiệm" CanUserResize="False" Width="*" Binding="{Binding IdTestNavigation.Name ,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="LOT QC" CanUserResize="False" Width="0.8*" Binding="{Binding IdControlDetailNavigation.Lot,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- New Index column -->
                            <DataGridTextColumn Header="Lần QC" CanUserResize="False" Width="0.8*" Binding="{Binding IndexQc}" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Qualitative" CanUserSort="False" CanUserResize="False" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding IdControlDetailNavigation.QualitativeMean,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ResultType}" Value="1">
                                                            <Setter Property="IsEnabled" Value="True"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Mean" CanUserSort="False" CanUserResize="False" Width="0.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding IdControlDetailNavigation.CurMean ,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ResultType ,UpdateSourceTrigger=PropertyChanged}" Value="2">
                                                            <Setter Property="IsEnabled" Value="True"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="SD" CanUserSort="False" CanUserResize="False" Width="0.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding IdControlDetailNavigation.CurSd,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ResultType,UpdateSourceTrigger=PropertyChanged}" Value="2">
                                                            <Setter Property="IsEnabled" Value="True"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Kết quả" CanUserSort="False" CanUserResize="False" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TempResult, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     BorderThickness="0" Background="Transparent"
                     IsReadOnly="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=IsReadOnly}"
                     PreviewKeyDown="TempResult_PreviewKeyDown">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Foreground" Value="Green" />
                                                    <Setter Property="FontSize" Value="14"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutRange}" Value="True">
                                                            <Setter Property="Foreground" Value="Red" />
                                                            <Setter Property="Background" Value="Yellow" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=IsReadOnly}" Value="False">
                                                            <Setter Property="Background" Value="#FFFFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Người TH" CanUserResize="False" Width="1*" IsReadOnly="True" Binding="{Binding IdUserNavigation.DisplayName,UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Ngày TH" CanUserResize="False" Width="1.1*" IsReadOnly="True" Binding="{Binding DateRun.Date,UpdateSourceTrigger=PropertyChanged, StringFormat=dd/MM/yyyy}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Giờ TH" CanUserResize="False" Width="1*" IsReadOnly="True" Binding="{Binding Time, Converter={StaticResource TimeSpanConverter}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- NEW: three checkboxes for reagent/cal change flags -->
                            <DataGridCheckBoxColumn Header="Thay thuốc thử" CanUserResize="False" Width="0.8*" Binding="{Binding IsReagentReplaced, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=IsReadOnly}" Value="False">
                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                                <DataGridCheckBoxColumn.EditingElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.EditingElementStyle>
                            </DataGridCheckBoxColumn>

                            <DataGridCheckBoxColumn Header="Thay LOT thuốc thử" CanUserResize="False" Width="0.9*" Binding="{Binding IsReagentLotChanged, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=IsReadOnly}" Value="False">
                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                                <DataGridCheckBoxColumn.EditingElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.EditingElementStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridCheckBoxColumn Header="Thay LOT Cal" CanUserResize="False" Width="0.8*" Binding="{Binding IsCalLotChanged, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=IsReadOnly}" Value="False">
                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                                <DataGridCheckBoxColumn.EditingElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.EditingElementStyle>
                            </DataGridCheckBoxColumn>


                            <DataGridTextColumn Header="Ghi chú" CanUserResize="False" Width="1.5*" Binding="{Binding Comment,UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Lỗi Westgard" CanUserResize="False" Width="1.5*" Binding="{Binding WestgardRule,UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- New Exclude column -->
                            <DataGridCheckBoxColumn Header="Loại trừ" CanUserResize="False" Width="0.6*" Binding="{Binding IsExclude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=IsReadOnly}" Value="False">
                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                                <DataGridCheckBoxColumn.EditingElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.EditingElementStyle>
                            </DataGridCheckBoxColumn>

                            <!-- Combined Actions column: status icon + delete -->
                            <DataGridTemplateColumn Header="Actions" CanUserResize="False" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" >
                                            <!-- Status icon -->
                                            <TextBlock Width="28" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value=""/>
                                                        <Setter Property="Foreground" Value="Black"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCorrected}" Value="True">
                                                                <Setter Property="Text" Value="✔"/>
                                                                <Setter Property="Foreground" Value="Green"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCorrected}" Value="False">
                                                                <Setter Property="Text" Value="✖"/>
                                                                <Setter Property="Foreground" Value="Red"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCorrected}" Value="{x:Null}">
                                                                <Setter Property="Text" Value=""/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Delete icon button -->
                                            <Button Command="{Binding DataContext.DeleteOneQCResultCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Width="30" Height="24" Margin="2,0"
                                        ToolTip="Delete"
                                        Background="Transparent" BorderThickness="0" Padding="0">
                                                <TextBlock Text="🗑" FontSize="14" Foreground="Blue" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>
                </materialDesign:Card>

                <!-- Calib Results card -->
                <materialDesign:Card Grid.Row="1"  Visibility="{Binding Visibility2}">
                    <DataGrid ItemsSource="{Binding CalList}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  SelectedItem="{Binding SelectedCalResult, Mode=OneWayToSource}"
                  CanUserAddRows="False"
                  CanUserResizeColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  ColumnWidth="*"
                  RowBackground="{StaticResource RowOddBrush}"
                  AlternatingRowBackground="{StaticResource RowEvenBrush}"
                  GridLinesVisibility="None"
                  BorderThickness="0"
                  HorizontalGridLinesBrush="Transparent"
                  VerticalGridLinesBrush="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Xét nghiệm" CanUserResize="False" Width="2*" Binding="{Binding IdTestNavigation.Name ,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="LOT QC" CanUserResize="False" Width="1*" Binding="{Binding IdCalDetailNavigation.IdCalInforNavigation.CalLot,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Level" CanUserResize="False" Width="0.8*" Binding="{Binding Level,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Min" CanUserResize="False" Width="1*" Binding="{Binding IdCalDetailNavigation.MinValue,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Max" CanUserResize="False" Width="1*" Binding="{Binding IdCalDetailNavigation.MaxValue,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Kết quả" CanUserResize="False" Width="1.2*" IsReadOnly="False" Binding="{Binding Result, Converter= {StaticResource TextCoverter}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Foreground" Value="Green" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding isOutOfRange}" Value="True">
                                                <Setter Property="Foreground" Value="Red" />
                                                <Setter Property="Background" Value="Yellow" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Người thực hiện" CanUserResize="False" Width="1*" IsReadOnly="True" Binding="{Binding IdUserNavigation.DisplayName,UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Ngày thực hiện" CanUserResize="False" Width="0.9*" IsReadOnly="True" Binding="{Binding DateRun.Date,UpdateSourceTrigger=PropertyChanged, StringFormat=dd/MM/yyyy}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Giờ thực hiện" CanUserResize="False" Width="0.7*" IsReadOnly="True" Binding="{Binding Time, Converter={StaticResource TimeSpanConverter}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Ghi chú" CanUserResize="False" Width="1.2*" Binding="{Binding Comment,UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Actions" CanUserResize="False" Width="0.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button 
                                Content="Delete" 
                                Command="{Binding DataContext.DeleteOneCalResultCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <TextBlock TextDecorations="Underline">
                                     <ContentPresenter />
                                                    </TextBlock>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Foreground" Value="Blue" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="true">
                                                            <Setter Property="Foreground" Value="Red" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>
                </materialDesign:Card>
            </Grid>

        </Border>
           
    </Grid>
</UserControl>