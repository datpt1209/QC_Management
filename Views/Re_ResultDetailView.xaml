<Window x:Class="QC_Management.Views.Re_ResultDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QC_Management.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Title="Danh sách kết quả QC" Height="450" Width="800">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}">
            </i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <materialDesign:Card Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBox 
                            Margin="5"
                            Width="150"
                            VerticalAlignment="Center" 
                            materialDesign:HintAssist.Hint="Thiết bị:"
                            Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            TextWrapping="Wrap" Height="50"/>

                        <TextBox 
                            Margin="5"
                            VerticalAlignment="Center" 
                            materialDesign:HintAssist.Hint="Level"
                            Text="{Binding LevelName, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            TextWrapping="Wrap" Width="150" Height="50"/>
                        <DatePicker 
                            Margin="5"
                            SelectedDate="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
    
                            materialDesign:HintAssist.Hint="Ngày"
   
                            materialDesign:TextFieldAssist.HasClearButton="True" 
    
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" Width="128" Height="50" />

                        <materialDesign:TimePicker  
                            Width="140"
                            Margin="5"
                            SelectedTime="{Binding TimeAsDateTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:HintAssist.HelperText="Helper text"
                            materialDesign:HintAssist.Hint="Pick Time"
                            Is24Hours="True"
                            Style="{StaticResource MaterialDesignOutlinedTimePicker}" >

                        </materialDesign:TimePicker>

                    </StackPanel>
                </materialDesign:Card>
            </Grid>
            
            <Grid Grid.Column="1">
                <materialDesign:Card  Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding SaveCommand}" Content="Lưu" Margin="5" Width="100"/>
                        <Button Command="{Binding CancelCommand}" Content="Hủy" Margin="5" Width="100"/>
                        <Button Command="{Binding DeleteCommand}" Content="Xóa" Margin="5" Width="100"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
           
        </Grid>

        <Grid Grid.Row="1">
            <DataGrid Name="input"
                      ItemsSource="{Binding ResutlViewList}"
                      AutoGenerateColumns="False"
                      SelectedItem="{Binding SelectedItem, Mode=OneWayToSource}"
                      CanUserAddRows="False"
                      PreviewKeyDown="InputDataGrid_PreviewKeyDown"> <!-- wired handler -->
                <DataGrid.Columns >
                    <!-- columns unchanged -->
                    <DataGridTextColumn Header="Xét nghiệm" 
                                        CanUserSort="False"
                                        Binding="{Binding TestName}" IsReadOnly="True" />
                    <DataGridTextColumn Header="LOT QC"
                                        Binding="{Binding LOT }"
                                        CanUserSort="False" IsReadOnly="True" />

                    <DataGridTemplateColumn Header="Qualitative"
                                            CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding QualitativeMean}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultType}" Value="1">
                                                    <Setter Property="IsEnabled" Value="True"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Mean" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding MeanApp}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultType}" Value="2">
                                                    <Setter Property="IsEnabled" Value="True"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="SD" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding SdApp}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultType}" Value="2">
                                                    <Setter Property="IsEnabled" Value="True"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Kết quả"
                                        CanUserSort="False" IsReadOnly="False" Binding="{Binding TempResult}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="Green" />
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <!--Màu mặc định-->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding isOutOfRange}" Value="True">
                                        <Setter Property="Foreground" Value="Red" />
                                        <Setter Property="Background" Value="Yellow" />
                                        <!--Thay đổi màu nền nếu ngoài 3 SD-->
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding isOut2SD}" Value="True">
                                        <Setter Property="Foreground" Value="Red" />
                                        <!--Thay đổi màu nền nếu ngoài 2 SD-->
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <EventSetter Event="PreviewTextInput" Handler="DataGridTextColumn_PreviewTextInput"/>
                                <EventSetter Event="DataObject.Pasting" Handler="DataGridTextColumn_Pasting"/>

                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- New Westgard column -->
                    <DataGridTextColumn Header="Westgard" CanUserSort="False" Binding="{Binding WestgardRule}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <!-- default color when rule exists -->
                                <Setter Property="Foreground" Value="Red"/>
                                <Setter Property="ToolTip" Value="{Binding WestgardRule}"/>
                                <Style.Triggers>
                                    <!-- treat null/empty as no-rule -> show normal color (black) -->
                                    <DataTrigger Binding="{Binding WestgardRule, TargetNullValue=''}" Value="">
                                        <Setter Property="Foreground" Value="Black"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Ghi chú" 
                                        Width="*" 
                                        IsReadOnly="False"
                                        Binding="{Binding Comment}"></DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>