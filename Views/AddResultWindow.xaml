<Window x:Class="QC_Management.Views.AddResultWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QC_Management.Views" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Danh sách kết quả QC" Height="450" Width="800" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <materialDesign:Card Grid.Row="0" Margin="5">
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="Ngày thực hiện" Margin="5"/>
                <TextBox Text="{Binding SelectedDate, Mode=OneWay}" Margin="5" IsReadOnly="True"/>
                <TextBlock Text="Thiết bị" Margin="5"/>
                <TextBox Text="{Binding SelectedDevice.Name, Mode=OneWay}" Margin="5" IsReadOnly="True"/>
                <TextBlock Text="Level" Margin="5"/>
                <TextBox Text="{Binding SelectedLevel.Name, Mode=OneWay}" Margin="5" IsReadOnly="True"/>
                <TextBlock Text="Index" Margin="5"/>
                <TextBox Text="{Binding SelectedIndex, Mode=OneWay}" Margin="5" IsReadOnly="True"/>
            </StackPanel>
        </materialDesign:Card>
        <materialDesign:Card Margin="5" Grid.Row="1">
            <StackPanel Orientation="Horizontal" Margin="10">
                <ComboBox 
                    Margin="5"
                    ItemsSource="{Binding TestList}"
                    DisplayMemberPath="Name"
                    SelectedItem="{Binding SelectedTest, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:ComboBoxAssist.MaxLength="2"
                    materialDesign:HintAssist.Hint="Tên xét nghiệm"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                    IsEditable="True" VerticalAlignment="Top" Width="150" Height="50">
                </ComboBox>
                <TextBox 
                    VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    materialDesign:HintAssist.Hint="Kết quả"
                    Text="{Binding ResultString, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Margin="5"
                    Width="200" Height="50"
                    AcceptsReturn="True"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    TextWrapping="Wrap" />

                <TextBox 
                    VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    materialDesign:HintAssist.Hint="Ghi chú"
                    Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Margin="5"
                    Width="200" Height="50"
                    AcceptsReturn="True"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    TextWrapping="Wrap" />

                <Button Content="Add" Command="{Binding AddResultCommand}" Margin="5"/>
            </StackPanel>

        </materialDesign:Card>

        <materialDesign:Card Margin="5" Grid.Row="2">
            <!--<DataGrid ItemsSource="{Binding NewResults}" AutoGenerateColumns="False" Margin="10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên xét nghiệm" Binding="{Binding IdTestNavigation.Name}" IsReadOnly="True"/>


                    <DataGridTextColumn Header="Mean" Binding="{Binding IdControlDetailNavigation.MeanApp}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="SD" Binding="{Binding IdControlDetailNavigation.SdApp}" IsReadOnly="True"/>
                    <DataGridTextColumn  Header="Kết quả" CanUserSort="False" IsReadOnly="False" Binding="{Binding Result1, Converter= {StaticResource TextCoverter}}">

                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding Comment}" IsReadOnly="True"/>

                </DataGrid.Columns>
            </DataGrid>-->
            <DataGrid 
     Background="White"
     Name="input" 
     ItemsSource="{Binding NewResults}" 
     AutoGenerateColumns="False"
     SelectedItem="{Binding SelectedItem, Mode=OneWayToSource}"
     CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Xét nghiệm" CanUserSort="False" Binding="{Binding IdTestNavigation.Name}" IsReadOnly="True" />
                    <DataGridTextColumn Header="LOT QC" Binding="{Binding IdControlDetailNavigation.Lot }" CanUserSort="False" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="Qualitative" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding IdControlDetailNavigation.QualitativeMean}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultType}" Value="1">
                                                    <Setter Property="IsEnabled" Value="True"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Mean" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding IdControlDetailNavigation.MeanApp}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultType}" Value="2">
                                                    <Setter Property="IsEnabled" Value="True"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="SD" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding IdControlDetailNavigation.SdApp}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultType}" Value="2">
                                                    <Setter Property="IsEnabled" Value="True"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Kết quả" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding TempResult, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Foreground" Value="Green" />
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOutRange}" Value="True">
                                                    <Setter Property="Foreground" Value="Red" />
                                                    <Setter Property="Background" Value="Yellow" />
                                                    <!--Thay đổi màu nền nếu ngoài 3 SD-->
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Ghi chú" Width="auto" IsReadOnly="False" Binding="{Binding Comment}"></DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Save" Command="{Binding SaveCommand}" Margin="5"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
