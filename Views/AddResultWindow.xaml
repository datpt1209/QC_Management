<Window x:Class="QC_Management.Views.AddResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Result" Height="300" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical" Margin="10">
            <TextBlock Text="Ngày thực hiện" Margin="5"/>
            <TextBox Text="{Binding SelectedDate, Mode=TwoWay}" Margin="5"/>
            <TextBlock Text="Thiết bị" Margin="5"/>
            <TextBox Text="{Binding SelectedDevice.Name, Mode=TwoWay}" Margin="5"/>
            <TextBlock Text="Level" Margin="5"/>
            <TextBox Text="{Binding SelectedLevel.Name, Mode=TwoWay}" Margin="5"/>
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding NewResults}" AutoGenerateColumns="False" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Test" Binding="{Binding Test}" />
                <DataGridTextColumn Header="Result" Binding="{Binding Result}" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Save" Command="{Binding SaveCommand}" Margin="5"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
