<UserControl x:Class="QC_Management.Views.PulseDotsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             IsHitTestVisible="False"
             Visibility="Collapsed">
    <UserControl.Resources>
        <Color x:Key="DotColor">#1C8FC5</Color>

        <!-- ── Storyboard: 3 dots nhịp nhàng lần lượt ── -->
        <Storyboard x:Key="PulseSb" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Dot1Scale"
                Storyboard.TargetProperty="ScaleX">
                <LinearDoubleKeyFrame KeyTime="0:0:0.0"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.2"  Value="1.4"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.4"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.2"  Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Dot1Scale"
                Storyboard.TargetProperty="ScaleY">
                <LinearDoubleKeyFrame KeyTime="0:0:0.0"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.2"  Value="1.4"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.4"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.2"  Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Dot1"
                Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0.0"  Value="0.35"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.2"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.4"  Value="0.35"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.2"  Value="0.35"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- Dot 2 — trễ 0.2s -->
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Dot2Scale"
                Storyboard.TargetProperty="ScaleX">
                <LinearDoubleKeyFrame KeyTime="0:0:0.0"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.2"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.4"  Value="1.4"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.6"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.2"  Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Dot2Scale"
                Storyboard.TargetProperty="ScaleY">
                <LinearDoubleKeyFrame KeyTime="0:0:0.0"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.2"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.4"  Value="1.4"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.6"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.2"  Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Dot2"
                Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0.0"  Value="0.35"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.2"  Value="0.35"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.4"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.6"  Value="0.35"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.2"  Value="0.35"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- Dot 3 — trễ 0.4s -->
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Dot3Scale"
                Storyboard.TargetProperty="ScaleX">
                <LinearDoubleKeyFrame KeyTime="0:0:0.0"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.4"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.6"  Value="1.4"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.8"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.2"  Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Dot3Scale"
                Storyboard.TargetProperty="ScaleY">
                <LinearDoubleKeyFrame KeyTime="0:0:0.0"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.4"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.6"  Value="1.4"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.8"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.2"  Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Dot3"
                Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0.0"  Value="0.35"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.4"  Value="0.35"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.6"  Value="1.0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.8"  Value="0.35"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.2"  Value="0.35"/>
            </DoubleAnimationUsingKeyFrames>

        </Storyboard>

        <!-- ── Fade in overlay ── -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation
                Storyboard.TargetName="OverlayGrid"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>

        <!-- ── Fade out overlay ── -->
        <Storyboard x:Key="FadeOut" Completed="FadeOut_Completed">
            <DoubleAnimation
                Storyboard.TargetName="OverlayGrid"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0" Duration="0:0:0.25"/>
        </Storyboard>

    </UserControl.Resources>

    <Grid x:Name="OverlayGrid" Opacity="0">

        <!-- Nền trắng mờ -->
        <Rectangle Fill="#DDFFFFFF" RadiusX="6" RadiusY="6"/>

        <!-- ══ 3 chấm pulse ══ -->
        <StackPanel x:Name="LoadingPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Ellipse x:Name="Dot1" Width="11" Height="11" Margin="5,0"
                         Fill="#1C8FC5" Opacity="0.35">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="Dot1Scale" CenterX="5.5" CenterY="5.5"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Dot2" Width="11" Height="11" Margin="5,0"
                         Fill="#1C8FC5" Opacity="0.35">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="Dot2Scale" CenterX="5.5" CenterY="5.5"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Dot3" Width="11" Height="11" Margin="5,0"
                         Fill="#1C8FC5" Opacity="0.35">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="Dot3Scale" CenterX="5.5" CenterY="5.5"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </StackPanel>

            <TextBlock Text="Đang tải dữ liệu..."
                       Margin="0,10,0,0" FontSize="12"
                       Foreground="#FF1C8FC5"
                       HorizontalAlignment="Center"/>
        </StackPanel>

    </Grid>
</UserControl>
