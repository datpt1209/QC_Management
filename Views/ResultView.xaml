<UserControl x:Class="QC_Management.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}"
             DataContext="{StaticResource ResultVM}"
             Name="Objectview" d:DesignHeight="600" d:DesignWidth="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}">
            </i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <!--các element binding từ selected item-->
            <materialDesign:Card Grid.Row="0" Margin="5">
                <WrapPanel >
                    <ComboBox
                        Margin="5"
                        ItemsSource="{Binding ResultTypes}"
                        SelectedItem="{Binding SelectedResultType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="Loại kết quả"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        Width="150" Height="50"
                        Background="{Binding SelectedResultType, Converter={StaticResource SelectedTypeToBackgroundConverter}}"/>

                    <ComboBox
                        Margin="5"
                        ItemsSource="{Binding DeviceList}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Thiết bị"
                        materialDesign:HintAssist.HintOpacity="0.26"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                         materialDesign:HintAssist.IsFloating="True"
                        IsEditable="True" VerticalAlignment="Top" Width="150" Height="50">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding DeviceSelectionChanged}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                   
                    <ComboBox 
                        Margin="5"
                        ItemsSource="{Binding LevelList}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Level"
                        materialDesign:HintAssist.IsFloating="True"
                        materialDesign:HintAssist.HintOpacity=".26"
                        Visibility="{Binding Visibility1, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        IsEditable="True" VerticalAlignment="Top" Width="150" Height="50">
                        
                    </ComboBox>

                    <ComboBox
                        Visibility="{Binding Visibility2, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        Margin="5"
                        DisplayMemberPath="CalTypeName"
                        ItemsSource="{Binding CalTypeList}"
                        SelectedItem="{Binding SelectedCalType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Loại Cal"
                        materialDesign:HintAssist.IsFloating="True"
                        materialDesign:HintAssist.HintOpacity=".26"
                        IsEditable="True" VerticalAlignment="Top" Width="150" Height="50"/>


                    <DatePicker          
                        Margin="5"  
                        SelectedDate="{Binding SelectedDate, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="Ngày thực hiện"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" Width="150" Height="50">
                    </DatePicker>
                    <ComboBox 
                        IsEnabled="True"
                        Visibility="{Binding Visibility1, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        Margin="5"
                        ItemsSource="{Binding IndexList}"
                        SelectedItem="{Binding SelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Lần QC"
                        materialDesign:HintAssist.IsFloating="True"
                        materialDesign:HintAssist.HintOpacity=".26"
                        IsEditable="True" VerticalAlignment="Top" Width="150" Height="50"/>
                     </WrapPanel>
            </materialDesign:Card>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="0.7*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <materialDesign:Card  Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding AddCommand}" Content="Lưu" Margin="5" Width="100"/>
                            <Button Command="{Binding InputCommand}" Content="Load"  Margin="5" Width="100"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
                <Grid Grid.Column="1">
                    <materialDesign:Card Margin="5">
                        <TextBlock 
                            Text="Kết quả QC Chưa lưu" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            FontSize="20"
                        />
                    </materialDesign:Card>
                </Grid>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="0.7*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                
                <materialDesign:Card   
                    Grid.Row="2" Margin="5" 
                    d:Visibility="Collapsed"
                    Name="qcResult"
                    Visibility="{Binding Visibility1, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Stretch">
                    <DataGrid 
                        Background="White"
                        Name="input" 
                        ItemsSource="{Binding ResutlViewList}" 
                        AutoGenerateColumns="False"
                        SelectedItem="{Binding SelectedItem, Mode=OneWayToSource}"
                        CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Xét nghiệm" CanUserSort="False" Binding="{Binding TestName}" IsReadOnly="True" />
                            <DataGridTextColumn Header="LOT QC" Binding="{Binding LOT }" CanUserSort="False" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Qualitative" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding QualitativeMean}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ResultType}" Value="1">
                                                            <Setter Property="IsEnabled" Value="True"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Mean" CanUserSort="False" 
                                                IsReadOnly="False" Binding="{Binding MeanApp}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <!--Màu mặc định-->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultType}" Value="2">
                                                <Setter Property="IsEnabled" Value="True"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="SD" CanUserSort="False" 
                              IsReadOnly="False" Binding="{Binding SdApp}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <!--Màu mặc định-->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultType}" Value="2">
                                                <Setter Property="IsEnabled" Value="True"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Kết quả" CanUserSort="False" IsReadOnly="False" Binding="{Binding TempResult}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="Green" />
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <!--Màu mặc định-->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding isOutOfRange}" Value="True">
                                                <Setter Property="Foreground" Value="Red" />
                                                <Setter Property="Background" Value="Yellow" />
                                                <!--Thay đổi màu nền nếu ngoài 3 SD-->
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding isOut2SD}" Value="True">
                                                <Setter Property="Foreground" Value="Red" />
                                                <!--Thay đổi màu nền nếu ngoài 2 SD-->
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <EventSetter Event="PreviewTextInput" Handler="DataGridTextColumn_PreviewTextInput"/>
                                        <EventSetter Event="DataObject.Pasting" Handler="DataGridTextColumn_Pasting"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ghi chú" Width="auto" IsReadOnly="False" Binding="{Binding Comment}"></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>

                <materialDesign:Card   
                    d:Visibility="Visible"
                    Grid.Row="2" Margin="5" 
                    Name="calResult"
                    Visibility="{Binding Visibility2, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Stretch">
                    <DataGrid 
                        Background="White"
                        Name="calResultdtg" 
                        ItemsSource="{Binding CalibInputList}" 
                        AutoGenerateColumns="False"
                        SelectedItem="{Binding SelectedCalibInput, Mode=OneWayToSource}"
                        CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Xét nghiệm" CanUserSort="False" Binding="{Binding TestName}" IsReadOnly="True" />
                            <DataGridTextColumn Header="LOT" Binding="{Binding Lot }" CanUserSort="False" IsReadOnly="True" />
                            <DataGridTextColumn Header="Level" Binding="{Binding Level }" CanUserSort="False" IsReadOnly="True" />
                            <DataGridTextColumn Header="Min" Binding="{Binding Min }" CanUserSort="False" IsReadOnly="True" />
                            <DataGridTextColumn Header="Max" Binding="{Binding Max }" CanUserSort="False" IsReadOnly="True" />

                            <DataGridTextColumn Header="Kết quả" CanUserSort="False" IsReadOnly="False" Binding="{Binding Result}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="Green" />
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <!--Màu mặc định-->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutRange}" Value="True">
                                                <Setter Property="Foreground" Value="Red" />
                                                <Setter Property="Background" Value="Yellow" />
                                                <!--Thay đổi màu nền nếu ngoài 3 SD-->
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <EventSetter Event="PreviewTextInput" Handler="DataGridTextColumn_PreviewTextInput"/>
                                        <EventSetter Event="DataObject.Pasting" Handler="DataGridTextColumn_Pasting"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ghi chú" Width="auto" IsReadOnly="False" Binding="{Binding Comment}"></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>


                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <materialDesign:Card Margin="5">
                            <DataGrid Background="White" 
                                      ItemsSource="{Binding GroupedReResults}" 
                                      SelectedItem="{Binding SelectedReResultGroup}" 
                                      Margin="10"
                                      HorizontalContentAlignment="Center" 
                                      VerticalContentAlignment="Center" IsReadOnly="True" AutoGenerateColumns="False">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding ShowDetailCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Thiết bị" Width="120" Binding="{Binding DeviceName}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Level" Width="90" Binding="{Binding LevelName}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Lần QC" Width="90" Binding="{Binding Index}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Ngày" Width="110" Binding="{Binding DateTime, StringFormat={}{0:dd/MM/yyyy}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Giờ" Width="100" Binding="{Binding Time, StringFormat={}{0:hh\\:mm\\:ss}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- Add more columns as needed -->
                                </DataGrid.Columns>
                            </DataGrid>
                        </materialDesign:Card>
                      
                    </Grid>
                    <Grid Grid.Row="1">
                        <materialDesign:Card Margin="5">
                            <TextBlock 
                                FontSize="20"
                                FontWeight="Bold"
                                Text="Kết quả CAL Chưa lưu"
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center"/>
                        </materialDesign:Card>
                    </Grid>
                    <Grid Grid.Row="2">
                        <materialDesign:Card Margin="5">
                            <DataGrid 
                                Background="White"
                                Name="calNoSave" ItemsSource="{Binding CalGroupResult}" AutoGenerateColumns="False"
                                      SelectedItem="{Binding SelectedCalGroup, Mode=OneWayToSource}"
                                      CanUserAddRows="False">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding ShowCalDetailCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <DataGrid.Columns >
                                    <DataGridTextColumn Header="Thiết bị" CanUserSort="False" Binding="{Binding DeviceName}" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Lần CAL" Binding="{Binding Index }" CanUserSort="False" IsReadOnly="True" />
                                    <DataGridTextColumn IsReadOnly="True" Header="Ngày" Width="110" Binding="{Binding DateRun, StringFormat={}{0:dd/MM/yyyy}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True" Header="Giờ" Width="100" Binding="{Binding Time, StringFormat={}{0:hh\\:mm\\:ss}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </materialDesign:Card>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

