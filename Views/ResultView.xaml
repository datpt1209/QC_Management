<UserControl x:Class="QC_Management.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:QC_Management.Helpers"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}"
             DataContext="{StaticResource ResultVM}"
             Name="Objectview" d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <helpers:VisibilityToColumnWidthConverter x:Key="VisibilityToColumnWidthConverter"/>

        <DataTemplate x:Key="WrappedHeaderTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" Margin="4,2" FontWeight="SemiBold"/>
        </DataTemplate>

        <!-- Apply header wrapping to all DataGridColumnHeader in this control -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="ContentTemplate" Value="{StaticResource WrappedHeaderTemplate}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="#FFF3F6F9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}">
            </i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="70" CornerRadius="10" Background="#FF1F2937" Padding="12" Margin="5">
            <DockPanel>
                <TextBlock Text="Nhập kết quả" Foreground="White" FontSize="20" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <!--các element binding từ selected item-->
            <materialDesign:Card Grid.Row="0" Margin="5">
                <WrapPanel >
                    <ComboBox
                        Margin="5"
                        ItemsSource="{Binding ResultTypes}"
                        SelectedItem="{Binding SelectedResultType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="Loại kết quả"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        Width="150" Height="50"
                        Background="{Binding SelectedResultType, Converter={StaticResource SelectedTypeToBackgroundConverter}}"/>

                    <ComboBox
                        Margin="5"
                        ItemsSource="{Binding DeviceList}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Thiết bị"
                        materialDesign:HintAssist.HintOpacity="0.26"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                         materialDesign:HintAssist.IsFloating="True"
                        IsEditable="True" VerticalAlignment="Top" Width="150" Height="50">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding DeviceSelectionChanged}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <ComboBox 
                        Margin="5"
                        ItemsSource="{Binding LevelList}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Level"
                        materialDesign:HintAssist.IsFloating="True"
                        materialDesign:HintAssist.HintOpacity=".26"
                        Visibility="{Binding Visibility1, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        IsEditable="True" VerticalAlignment="Top" Width="150" Height="50">

                    </ComboBox>

                    <ComboBox
                        Visibility="{Binding Visibility2, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        Margin="5"
                        DisplayMemberPath="CalTypeName"
                        ItemsSource="{Binding CalTypeList}"
                        SelectedItem="{Binding SelectedCalType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Loại Cal"
                        materialDesign:HintAssist.IsFloating="True"
                        materialDesign:HintAssist.HintOpacity=".26"
                        IsEditable="True" VerticalAlignment="Top" Width="150" Height="50"/>
                    <DatePicker          
                        Margin="5"  
                        SelectedDate="{Binding SelectedDate, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="Ngày thực hiện"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" Width="150" Height="50">
                    </DatePicker>

                    <!-- TimePicker: render visually identical to DatePicker by using an outlined frame (floating hint attached to the frame)
                         - outer Border provides the outlined chrome and floating hint exactly like the DatePicker
                         - inner TimePicker set borderless/transparent so chrome comes from outer Border -->
                    <Border Margin="5" Width="150" Height="50" CornerRadius="4"
                            Background="{DynamicResource MaterialDesignPaper}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                            materialDesign:HintAssist.Hint="Giờ thực hiện"
                            materialDesign:HintAssist.IsFloating="True"
                            materialDesign:TextFieldAssist.HasClearButton="True">
                        <materialDesign:TimePicker
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Margin="2,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Is24Hours="True"
                            SelectedTime="{Binding SelectedDateTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignOutlinedTimePicker}" />
                    </Border>

                    <!-- Replace the display-only TextBox for index with this ComboBox (binds to IndexList / SelectedIndex).
     SelectedIndex is already set to the last item in the VM when IndexList is built, and IsIndexSelectionEnabled
     (set in LoadUsers) controls whether the control is enabled only for admins. -->
                    <ComboBox
                        Margin="5"
                        Visibility="{Binding Visibility1, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding IndexList}"
                        SelectedItem="{Binding SelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsIndexSelectionEnabled}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        Width="150" Height="50"
                        materialDesign:HintAssist.Hint="Lần QC" />
                    <!-- NEW: User selection -->
                    <ComboBox
                        Margin="5"
                        ItemsSource="{Binding UserList}"
                        DisplayMemberPath="DisplayName"
                        SelectedItem="{Binding SelectedUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsUserSelectionEnabled}"
                        materialDesign:HintAssist.Hint="Người thực hiện"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        Width="150" Height="50"
                        ToolTip="{Binding SelectedUser.RoleNavigation.DisplayName}" />

                </WrapPanel>
            </materialDesign:Card>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="0.7*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <materialDesign:Card  Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding AddCommand}" Content="Lưu" Margin="5" Width="100"/>
                            <Button Command="{Binding InputCommand}" Content="Load"  Margin="5" Width="100"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
                <Grid Grid.Column="1">
                    <materialDesign:Card Margin="5">
                        <TextBlock 
                            Text="Kết quả QC Chưa lưu" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            FontSize="20"
                        />
                    </materialDesign:Card>
                </Grid>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="0.7*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <materialDesign:Card   
                    Grid.Row="2" Margin="5" 
                    d:Visibility="Collapsed"
                    Name="qcResult"
                    Visibility="{Binding Visibility1, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Stretch">
                    <DataGrid 
                        Background="White"
                        Name="input" 
                        ItemsSource="{Binding ResutlViewList}" 
                        AutoGenerateColumns="False" 
                        SelectedItem="{Binding SelectedItem, Mode=OneWayToSource}"
                        CanUserAddRows="False"
                        PreviewKeyDown="InputDataGrid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Xét nghiệm" CanUserSort="False" Binding="{Binding TestName}" IsReadOnly="True" Width="2*" />
                            <DataGridTextColumn Header="LOT QC" Binding="{Binding LOT }" CanUserSort="False" IsReadOnly="True" Width="*" />
                            <!-- Width bind qua attached property: Visible→1* / Collapsed→0 -->
                            <DataGridTextColumn x:Name="ColQualitative" Header="Qualitative" CanUserSort="False"
                                helpers:DataGridColumnWidthHelper.BindableWidth="{Binding DataContext.ShowQualitative,
                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                    Converter={StaticResource VisibilityToColumnWidthConverter}}"
                                Binding="{Binding QualitativeMean, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultType}" Value="1">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="IsReadOnly" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultType}" Value="1">
                                                <Setter Property="IsReadOnly" Value="False"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Mean" CanUserSort="False" IsReadOnly="True" Width="*" Binding="{Binding MeanApp}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultType}" Value="2">
                                                <Setter Property="IsEnabled" Value="True"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SD" CanUserSort="False" IsReadOnly="True" Width="*" Binding="{Binding SdApp}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultType}" Value="2">
                                                <Setter Property="IsEnabled" Value="True"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Kết quả" CanUserSort="False" IsReadOnly="False" Width="*" Binding="{Binding TempResult}">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="LightGray"/>
                                        <Setter Property="Foreground" Value="Green"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TempResult}" Value="">
                                                <Setter Property="Background" Value="#FFDCDCDC"/>
                                                <Setter Property="Foreground" Value="Gray"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding isOutRange}" Value="True">
                                                <Setter Property="Background" Value="Yellow"/>
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <EventSetter Event="PreviewTextInput" Handler="DataGridTextColumn_PreviewTextInput"/>
                                        <EventSetter Event="DataObject.Pasting" Handler="DataGridTextColumn_Pasting"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- Lỗi Westgard column -->
                            <DataGridTextColumn Header="Lỗi Westgard"
                                                CanUserSort="False"
                                                IsReadOnly="True"
                                                Binding="{Binding WestgardRule}" Width="1.5*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="Red"/>
                                        <Setter Property="ToolTip" Value="{Binding WestgardRule}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WestgardRule}" Value="{x:Null}">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding WestgardRule}" Value="">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- NEW: checkbox columns for changes -->
                            <DataGridTemplateColumn Header="Thay thuốc thử mới" CanUserSort="False" Width="55" MinWidth="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsReagentReplaced, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Thay LOT thuốc thử" CanUserSort="False" Width="55" MinWidth="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsReagentLotChanged, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Thay LOT cal" CanUserSort="False" Width="55" MinWidth="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsCalLotChanged, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Ghi chú" Width="1.5*" IsReadOnly="False" Binding="{Binding Comment}"></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>

                <!-- other cards / datagrids: set ColumnHeaderHeight="Auto" where needed -->
                <materialDesign:Card   
                    d:Visibility="Visible"
                    Grid.Row="2" Margin="5" 
                    Name="calResult"
                    Visibility="{Binding Visibility2, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Stretch">
                    <DataGrid 
                        Background="White"
                        Name="calresultdtg" 
                        ItemsSource="{Binding CalibInputList}" 
                        AutoGenerateColumns="False"
                        SelectedItem="{Binding SelectedCalibInput, Mode=OneWayToSource}"
                        CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Xét nghiệm" CanUserSort="False" Binding="{Binding TestName}" IsReadOnly="True" Width="2*" />
                            <DataGridTextColumn Header="LOT" Binding="{Binding Lot }" CanUserSort="False" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Level" Binding="{Binding Level }" CanUserSort="False" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Min" Binding="{Binding Min }" CanUserSort="False" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Max" Binding="{Binding Max }" CanUserSort="False" IsReadOnly="True" Width="*" />

                            <DataGridTextColumn Header="Kết quả" CanUserSort="False" IsReadOnly="False" Width="*" Binding="{Binding Result}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="Green" />
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <!--Màu mặc định-->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutRange}" Value="True">
                                                <Setter Property="Foreground" Value="Red" />
                                                <Setter Property="Background" Value="Yellow" />
                                                <!--Thay đổi màu nền nếu ngoài 3 SD-->
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <EventSetter Event="PreviewTextInput" Handler="DataGridTextColumn_PreviewTextInput"/>
                                        <EventSetter Event="DataObject.Pasting" Handler="DataGridTextColumn_Pasting"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ghi chú" Width="1.5*" IsReadOnly="False" Binding="{Binding Comment}"></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>


                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <materialDesign:Card Margin="5">
                            <DataGrid Background="White" 
                                      ItemsSource="{Binding GroupedReResults}" 
                                      SelectedItem="{Binding SelectedReResultGroup}" 
                                      Margin="10"
                                      HorizontalContentAlignment="Center" 
                                      VerticalContentAlignment="Center" IsReadOnly="True" AutoGenerateColumns="False">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding ShowDetailCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Thiết bị" Width="*" Binding="{Binding DeviceName}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Level" Width="*" Binding="{Binding LevelName}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Lần QC" Width="*" Binding="{Binding Index}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Ngày" Width="*" Binding="{Binding DateTime, StringFormat={}{0:dd/MM/yyyy}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Giờ" Width="*" Binding="{Binding Time, StringFormat={}{0:hh\\:mm\\:ss}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- Add more columns as needed -->
                                </DataGrid.Columns>
                            </DataGrid>
                        </materialDesign:Card>

                    </Grid>
                    <Grid Grid.Row="1">
                        <materialDesign:Card Margin="5">
                            <TextBlock 
                                FontSize="20"
                                FontWeight="Bold"
                                Text="Kết quả CAL Chưa lưu"
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center"/>
                        </materialDesign:Card>
                    </Grid>
                    <Grid Grid.Row="2">
                        <materialDesign:Card Margin="5">
                            <DataGrid 
                                Background="White"
                                Name="calNoSave" ItemsSource="{Binding CalGroupResult}" AutoGenerateColumns="False"
                                      SelectedItem="{Binding SelectedCalGroup, Mode=OneWayToSource}"
                                      CanUserAddRows="False">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding ShowCalDetailCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <DataGrid.Columns >
                                    <DataGridTextColumn Header="Thiết bị" CanUserSort="False" Binding="{Binding DeviceName}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="Lần CAL" Binding="{Binding Index }" CanUserSort="False" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn IsReadOnly="True" Header="Ngày" Width="*" Binding="{Binding DateRun, StringFormat={}{0:dd/MM/yyyy}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="True" Header="Giờ" Width="*" Binding="{Binding Time, StringFormat={}{0:hh\\:mm\\:ss}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </materialDesign:Card>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

