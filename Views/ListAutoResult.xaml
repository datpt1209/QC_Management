<Window x:Class="QC_Management.Views.ListAutoResult"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QC Result Details" Height="300" Width="400">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Device:" FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedQCResult.Device}" Margin="0,0,0,10"/>
            <TextBlock Text="Level:" FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedQCResult.Level}" Margin="0,0,0,10"/>
            <TextBlock Text="Date:" FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedQCResult.Date}" Margin="0,0,0,10"/>
            <TextBlock Text="Time:" FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedQCResult.Time}" Margin="0,0,0,10"/>
            <!-- Add more details as needed -->
        </StackPanel>
    </Grid>
</Window>