<Window x:Class="QC_Management.Views.ApplyRangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QC_Management.Views"
        mc:Ignorable="d"
        Title="Chọn khoảng thời gian áp dụng" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Ngày bắt đầu" Margin="0,0,0,4"/>
                <DatePicker x:Name="StartDatePicker" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Giờ (HH:mm)" Margin="0,0,0,4"/>
                <TextBox x:Name="StartTimeText" Width="80" Text="00:00"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Ngày kết thúc" Margin="0,0,0,4"/>
                <DatePicker x:Name="EndDatePicker" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Giờ (HH:mm)" Margin="0,0,0,4"/>
                <TextBox x:Name="EndTimeText" Width="80" Text="23:59"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Click="BtnCancel_Click" Width="90" Margin="4">Hủy</Button>
            <Button x:Name="BtnOk" Click="BtnOk_Click" Width="120" Margin="4">Áp dụng</Button>
        </StackPanel>
    </Grid>
</Window>
