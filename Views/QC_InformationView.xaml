<UserControl x:Class="QC_Management.Views.QC_InformationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QC_Management.Views"
             mc:Ignorable="d" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}"
             Name="Objectview" d:DesignHeight="600" d:DesignWidth="1200">
    <UserControl.Resources>
        <!-- Compact control styles: reduce padding/height and center content vertically -->
        <Style x:Key="CompactOutlinedTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CompactOutlinedComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- DatePicker's visual contains a DatePickerTextBox; set VerticalContentAlignment on DatePicker and Padding -->
        <Style x:Key="CompactOutlinedDatePicker" TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Status badge style (supports boolean and string statuses) -->
        <Style x:Key="StatusBadge" TargetType="ContentControl">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FF9E9E9E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Content}" Value="True">
                    <Setter Property="Background" Value="#2E7D32"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Content}" Value="False">
                    <Setter Property="Background" Value="#F9A825"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}">
            </i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="70" CornerRadius="10" Background="#FF1F2937" Padding="12" Margin="5">
            <DockPanel>
                <TextBlock Text="Thông tin QC" Foreground="White" FontSize="20" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: existing QC info -->
            <Grid Grid.Column="0">
                <!-- make left side fill vertically: header rows auto, list fills remaining -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- editor controls -->
                    <RowDefinition Height="Auto"/>
                    <!-- add/edit/delete buttons -->
                    <RowDefinition Height="*"/>
                    <!-- list fills remaining height -->
                </Grid.RowDefinitions>

                <materialDesign:Card Margin="5" Grid.Row="0">
                    <WrapPanel Margin="5">
                        <!-- Compact inputs using the new compact styles -->
                        <ComboBox
                     Margin="5"
                     ItemsSource="{Binding CategoryList}"
                     DisplayMemberPath="Name"
                     SelectedItem="{Binding SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource CompactOutlinedComboBox}"
                     materialDesign:HintAssist.Hint="Loại xét nghiệm"
                     IsEditable="True" Width="120">

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding CategorySelectionChangedCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>

                        <ComboBox
                     Margin="5"
                     ItemsSource="{Binding ListType}"
                     DisplayMemberPath="Name"
                     SelectedItem="{Binding SelectedType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource CompactOutlinedComboBox}"
                     materialDesign:HintAssist.Hint="Loại QC"
                     IsEditable="True" Width="120">

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding QCTypeSelectionChangedCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>

                        <TextBox 
                     Margin="5"
                     VerticalAlignment="Center" 
                     materialDesign:HintAssist.Hint="LOT"
                     Text="{Binding LOT, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Style="{StaticResource CompactOutlinedTextBox}"
                     TextWrapping="NoWrap" Width="120"/>
                        <DatePicker          
                     Margin="5"
                     SelectedDate="{Binding ProductionDate, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource CompactOutlinedDatePicker}"
                     materialDesign:HintAssist.Hint="Ngày sản xuất"
                     materialDesign:TextFieldAssist.HasClearButton="True" Width="120" />

                        <DatePicker               
                     Margin="5"
                     SelectedDate="{Binding ExpirationDate, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource CompactOutlinedDatePicker}"
                     materialDesign:HintAssist.Hint="Hạn sử dụng" 
                     materialDesign:TextFieldAssist.HasClearButton="True" Width="120" />
                        <CheckBox
                     Content="Kích hoạt"
                     IsChecked="{Binding isChecked_Info}" VerticalAlignment="Center" Margin="8,0"/>
                    </WrapPanel>
                </materialDesign:Card>

                <materialDesign:Card Margin="5" Grid.Row="1">
                    <WrapPanel>
                        <Button Command="{Binding AddCommand}" Content="Thêm" Margin="5" Width="100"
                         Background="#6B46C1" Foreground="White" FontWeight="SemiBold"/>
                        <Button Command="{Binding DeleteCommand}" Content="Xóa" Margin="5" Width="100"
                         Background="#D32F2F" Foreground="White"/>
                        <Button Command="{Binding EditCommand}" Content="Update" Margin="5" Width="100"
                         Background="#1976D2" Foreground="White"/>
                    </WrapPanel>
                </materialDesign:Card>

                <!-- this card now stretches to occupy remaining height -->
                <materialDesign:Card Margin="5" Grid.Row="2" VerticalAlignment="Stretch">
                    <ListView ItemsSource="{Binding List}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                        <ListView.View>
                            <GridView>
                                <!-- adjusted column widths so they fit the 380px column (allowing margins) -->
                                <GridViewColumn Header="Id" Width="40" DisplayMemberBinding="{Binding Id}"/>
                                <GridViewColumn Header="LOT" Width="100" DisplayMemberBinding="{Binding Lot}"/>
                                <GridViewColumn Header="Ngày sản xuất" Width="100" DisplayMemberBinding="{Binding ProductionDate, StringFormat=dd/MM/yyyy}"/>
                                <GridViewColumn Header="Hạn sử dụng" Width="100" DisplayMemberBinding="{Binding ExpirationDate,StringFormat=dd/MM/yyyy}"/>
                                <!-- Status column for LOT with colored badge -->
                                <GridViewColumn Header="Status" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Style="{StaticResource StatusBadge}" Content="{Binding Status}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </materialDesign:Card>
            </Grid>

            <Border Grid.Column="1" Background="#FFECECEC"/>

            <!-- RIGHT: QC detail area (ranges) with compact editor controls -->
            <Grid Grid.Column="2">
                <!-- rows: header, editor, actions, list (fills), optional quick actions -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <materialDesign:Card Margin="5" Grid.Row="0">
                    <TextBlock Text="Danh sách range (Chi tiết QC cho LOT đã chọn)" FontWeight="SemiBold" Margin="6"/>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="1" Margin="5">
                    <WrapPanel Margin="5">
                        <ComboBox
                   DisplayMemberPath="Name"
                   Margin="5"
                   ItemsSource="{Binding DeviceList}"
                   SelectedItem="{Binding SelectedDevice}"
                   Style="{StaticResource CompactOutlinedComboBox}"
                   IsEditable="True" Width="120">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding DeviceSelectionChangedCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>

                        <ComboBox
                   Margin="5"
                   ItemsSource="{Binding TestList}"
                   DisplayMemberPath="Name"
                   SelectedItem="{Binding SelectedTest, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource CompactOutlinedComboBox}"
                   IsEditable="True"
                   Width="120">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding TestSelectionChangedCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>

                        <ComboBox
                   Margin="5"
                   ItemsSource="{Binding LevelList}"
                   DisplayMemberPath="Name"
                   SelectedItem="{Binding SelectedLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource CompactOutlinedComboBox}"
                   IsEditable="True" Width="120"/>
                        <TextBox
                   Margin="5"
                   VerticalAlignment="Center"  
                   materialDesign:HintAssist.Hint="LOT"  
                   Text="{Binding LOT}"
                   AcceptsReturn="True"
                   Style="{StaticResource CompactOutlinedTextBox}"
                   TextWrapping="NoWrap" Width="120" />
                        <TextBox
                   Margin="5"
                   VerticalAlignment="Center" 
                   materialDesign:HintAssist.Hint="Mean Qualitative"
                   Text="{Binding QualitativeMean}"
                   IsEnabled="{Binding QualitativeMeanVisibility}"
                   AcceptsReturn="True"
                   Style="{StaticResource CompactOutlinedTextBox}"
                   TextWrapping="NoWrap"
                   Width="120" />
                        <TextBox
                   Margin="5"
                   VerticalAlignment="Center" 
                   materialDesign:HintAssist.Hint="Mean NSX"
                   Text="{Binding MeanNSX}"
                   IsEnabled="{Binding QuantativeVisibility}"
                   AcceptsReturn="False"
                   Style="{StaticResource CompactOutlinedTextBox}"
                   TextWrapping="NoWrap"
                   Width="120" />
                        <TextBox
                   Margin="5"
                   VerticalAlignment="Center" 
                   materialDesign:HintAssist.Hint="SD NSX"
                   Text="{Binding SDNSX}"
                   AcceptsReturn="False"
                   IsEnabled="{Binding QuantativeVisibility}"
                   Style="{StaticResource CompactOutlinedTextBox}"
                   TextWrapping="NoWrap" 
                   Width="120"/>
                        <TextBox
                   Margin="5"
                   VerticalAlignment="Center" 
                   materialDesign:HintAssist.Hint="Mean PXN"
                   Text="{Binding MeanPXN}"
                   IsEnabled="{Binding QuantativeVisibility}"
                   AcceptsReturn="False"
                   Style="{StaticResource CompactOutlinedTextBox}"
                   TextWrapping="NoWrap"
                   Width="120" />
                        <TextBox
                   Margin="5"
                   VerticalAlignment="Center" 
                   materialDesign:HintAssist.Hint="SD PXN"
                   Text="{Binding SdPXN}"
                   IsEnabled="{Binding QuantativeVisibility}"
                   AcceptsReturn="False"
                   Style="{StaticResource CompactOutlinedTextBox}"
                   TextWrapping="NoWrap" 
                   Width="120"/>
                        <!-- Current Mean: handle Enter -->
                        <TextBox
                   Margin="5"
                   VerticalAlignment="Center"  
                   materialDesign:HintAssist.Hint="Current Mean"
                   Text="{Binding CurMean}"
                   IsEnabled="{Binding QuantativeVisibility}"
                   AcceptsReturn="False"
                   Style="{StaticResource CompactOutlinedTextBox}"
                   TextWrapping="NoWrap" Width="120" />
                        <!-- Current Sd: handle Enter -->
                        <TextBox
                   Margin="5"
                   VerticalAlignment="Center" 
                   materialDesign:HintAssist.Hint="Current Sd"
                   Text="{Binding CurSd}"
                   IsEnabled="{Binding QuantativeVisibility}"
                   AcceptsReturn="False"
                   Style="{StaticResource CompactOutlinedTextBox}"
                   TextWrapping="NoWrap" Width="120"/>
                        <CheckBox
                   Content="Kích hoạt"
                   IsChecked="{Binding ischecked_detail}" VerticalAlignment="Center" Margin="8,0"/>
                    </WrapPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="2" Margin="5">
                    <StackPanel>
                        <WrapPanel Margin="5">
                            <Button Content="Thêm range" Width="110" Margin="5" Command="{Binding AddRangeCommand}"
                             Background="#6B46C1" Foreground="White" FontWeight="SemiBold"/>
                            <Button Content="Cập nhật" Width="110" Margin="5" Command="{Binding EditRangeCommand}"
                             Background="#1976D2" Foreground="White"/>
                            <Button Content="Xóa range" Width="110" Margin="5" Command="{Binding DeleteRangeCommand}"
                             Background="#D32F2F" Foreground="White"/>
                            <Button Content="Áp dụng Range" Width="130" Margin="5" Command="{Binding ApplyRangeAllCommand}"
                             Background="#2E7D32" Foreground="White"/>
                            <Button Content="Làm mới" Width="110" Margin="5" Command="{Binding LoadedCommand}"
                             Background="#9E9E9E" Foreground="White"/>
                        </WrapPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- list card fills remaining height; add internal ScrollViewer so long lists scroll -->
                <materialDesign:Card Grid.Row="3" Margin="5" VerticalAlignment="Stretch">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ListView ItemsSource="{Binding DetailList}" SelectedItem="{Binding SelectedDetail, Mode=TwoWay}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Device" Width="140" DisplayMemberBinding="{Binding IdDeviceNavigation.Name}"/>
                                    <GridViewColumn Header="Test" Width="140" DisplayMemberBinding="{Binding IdTestNavigation.Name}"/>
                                    <GridViewColumn Header="Level" Width="90" DisplayMemberBinding="{Binding IdLevelNavigation.Name}"/>
                                    <GridViewColumn Header="LOT" Width="70" DisplayMemberBinding="{Binding Lot}"/>
                                    <GridViewColumn Header="Mean (Cur)" Width="100" DisplayMemberBinding="{Binding CurMean}"/>
                                    <GridViewColumn Header="SD (Cur)" Width="100" DisplayMemberBinding="{Binding CurSd}"/>
                                    <GridViewColumn Header="MeanApp" Width="100" DisplayMemberBinding="{Binding MeanApp}"/>
                                    <GridViewColumn Header="SdApp" Width="100" DisplayMemberBinding="{Binding SdApp}"/>
                                    <!-- Status column for each parameter/range -->
                                    <GridViewColumn Header="Status" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource StatusBadge}" Content="{Binding Status}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </ScrollViewer>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="4" Margin="5">
                    <WrapPanel>
                        <!-- optional quick actions -->
                    </WrapPanel>
                </materialDesign:Card>
            </Grid>

        </Grid>
   
    </Grid>
</UserControl>

