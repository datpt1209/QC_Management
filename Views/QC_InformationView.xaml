<UserControl x:Class="QC_Management.Views.QC_InformationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QC_Management.Views"
             mc:Ignorable="d" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        DataContext="{StaticResource QC_InforVM}"
        Name="Objectview" d:DesignHeight="600" d:DesignWidth="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}">
            </i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Margin="0,0,0,-14">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <!--các element binding từ selected item-->
            <materialDesign:Card Grid.Row="0" Margin="5">
                <WrapPanel Margin="5">
                    <ComboBox
                        Margin="5"
                        ItemsSource="{Binding CategoryList}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Loại xét nghiệm"
                        Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                        materialDesign:HintAssist.HintOpacity=".26"
                        IsEditable="True" Height="50">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding CategorySelectionChangedCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <ComboBox
                        Margin="5"
                        ItemsSource="{Binding ListType}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Loại QC"
                        Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                        materialDesign:HintAssist.HintOpacity=".26"
                        IsEditable="True" Height="50">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding QCTypeSelectionChangedCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <TextBox 
                        Margin="5"
                        VerticalAlignment="Center"
                        materialDesign:HintAssist.Hint="Tên QC"
                        Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="True"
                        Style="{StaticResource MaterialDesignFilledTextBox}"
                        TextWrapping="Wrap" Width="auto" Height="50" />
                    <TextBox 
                        Margin="5"
                        VerticalAlignment="Center" 
                        materialDesign:HintAssist.Hint="LOT"
                        Text="{Binding LOT, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="True"
                        Style="{StaticResource MaterialDesignFilledTextBox}"
                        TextWrapping="Wrap" Width="auto" Height="50"/>
                    <DatePicker          
                        Margin="5"
                        
                        SelectedDate="{Binding ProductionDate, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="Ngày sản xuất"
                        materialDesign:TextFieldAssist.HasClearButton="True"    
                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}" Width="128" Height="50" />
                    <DatePicker               
                        Margin="5"
                        
                        SelectedDate="{Binding ExpirationDate, UpdateSourceTrigger=PropertyChanged}" 
                        materialDesign:HintAssist.Hint="Hạn sử dụng" 
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}" Width="128" Height="50" />
                    <CheckBox
                        Content="Kích hoạt"
                     
                        IsChecked="{Binding isChecked}"
                        />
                </WrapPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="1" Margin="5">
                <WrapPanel>
                    <Button Command="{Binding AddCommand}" Content="Thêm" Margin="5" Width="100"></Button>
                    <Button Command="{Binding DeleteCommand}" Content="Xóa" Margin="5" Width="100"></Button>
                    <Button Command="{Binding EditCommand}" Content="Sửa" Margin="5" Width="100"></Button>
                </WrapPanel>

            </materialDesign:Card>

            <materialDesign:Card Grid.Row="2" Margin="5" VerticalAlignment="Stretch">
                <ListView ItemsSource="{Binding List}" SelectedItem="{Binding SelectedItem, Mode=OneWayToSource}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Id" Width="30" DisplayMemberBinding="{Binding Id}"/>
                            <GridViewColumn Header="Tên QC" Width="120" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="LOT" Width="80" DisplayMemberBinding="{Binding Lot}"/>
                            <GridViewColumn Header="Ngày sản xuất" Width="110" DisplayMemberBinding="{Binding ProductionDate, StringFormat=dd/MM/yyyy}"/>
                            <GridViewColumn Header="Hạn sử dụng" Width="100" DisplayMemberBinding="{Binding ExpirationDate,StringFormat=dd/MM/yyyy}"/>
                            <GridViewColumn Header="Trạng thái" Width="100" DisplayMemberBinding="{Binding Status}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </materialDesign:Card>


        </Grid>
    </Grid>
</UserControl>

