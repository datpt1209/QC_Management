<Window x:Class="QC_Management.Views.CorrectiveActionReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Báo cáo hành động khắc phục" Height="700" Width="900"
        xmlns:winforms="clr-namespace:Microsoft.Reporting.WinForms;assembly=Microsoft.ReportViewer.WinForms"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="8" HorizontalAlignment="Right">
            <Button Name="btnSavePdf" Click="BtnSavePdf_Click" Margin="4" Width="100">Lưu PDF</Button>
            <Button Name="btnOpenPdf" Click="BtnOpenPdf_Click" Margin="4" Width="100">Mở PDF</Button>
            <Button Name="btnClose" Click="BtnClose_Click" Margin="4" Width="80">Đóng</Button>
        </StackPanel>

        
        <WindowsFormsHost Grid.Row="1">
            <winforms:ReportViewer x:Name="PdfViewer">

            </winforms:ReportViewer>
        </WindowsFormsHost>

    </Grid>
</Window>
