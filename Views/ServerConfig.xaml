<Window x:Class="QC_Management.Views.ServerConfig"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RegistUser"       
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"      
        TextElement.FontWeight="Regular"       
        TextElement.FontSize="13"   
        TextOptions.TextFormattingMode="Ideal"        
        TextOptions.TextRenderingMode="Auto"          
        FontFamily="{DynamicResource MaterialDesignFont}" 
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        WindowStartupLocation ="CenterScreen"
        Name="ConfigServer"
        Height="300" Width="400"
        DataContext="{StaticResource ServerConfigVM}">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Window_Loaded}">
            </i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <materialDesign:Card UniformCornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                </Grid.RowDefinitions>
                <materialDesign:Card  Margin="5,5,5,5"  Grid.Row="0">
                    <TextBox 
                            Name="serverTextbox"
                            VerticalAlignment="Center"
                             materialDesign:HintAssist.Hint="Server"
                             Text="{Binding Server}"
                             Margin="5,0,6,0"
                             AcceptsReturn="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             TextWrapping="Wrap" RenderTransformOrigin="0.5,0.5" >
              
                    </TextBox>
                </materialDesign:Card>

                <materialDesign:Card  Margin="5,5,5,5"  Grid.Row="1" >
                    <TextBox 
                            Name="UserNameTextbox"
                            VerticalAlignment="Center"
                             materialDesign:HintAssist.Hint="UserName"
                             Text="{Binding UserName}"
                             Margin="5,0,6,0"
                             AcceptsReturn="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             TextWrapping="Wrap" RenderTransformOrigin="0.5,0.5" >
                  
                    </TextBox>
                </materialDesign:Card>

                <materialDesign:Card  Margin="5,5,5,5" Grid.Row="2"  >
                    <PasswordBox
                         materialDesign:HintAssist.Hint="Password"
                         Style="{StaticResource MaterialDesignFilledPasswordBox}"
                         materialDesign:PasswordBoxAssist.Password="{Binding PassWord}">
                        
                    </PasswordBox>
                    
                </materialDesign:Card>

                <materialDesign:Card  Margin="5,5,5,5"  Grid.Row="3"  >
                    <TextBox 
                        Name="databaseTextbox"
                        VerticalAlignment="Top" HorizontalAlignment="Stretch"
                             materialDesign:HintAssist.Hint="Database"
                             Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                                Margin="5 5 5 5"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             TextWrapping="Wrap" />
                </materialDesign:Card>
            </Grid>
            <Grid Grid.Row="1">
                <materialDesign:Card >
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center">
                        <Button HorizontalAlignment="Left" 
                                Content="Lưu" Width="80" 
                                IsDefault="true" 
                                CommandParameter="{Binding ElementName=ConfigServer}"
                                Command="{Binding okButton_Click}"></Button>
                        <Button HorizontalAlignment="Right" Margin="10, 0, 0, 0" Width="80" IsCancel="true" Content="Cancel"></Button>
                        <Button HorizontalAlignment="Right" Margin="10, 0, 0, 0" Width="120"  Content="TestConnect" Command="{Binding TestConnect_click}"></Button>

                    </StackPanel>

                </materialDesign:Card>
            </Grid>
        </Grid>
    </materialDesign:Card>

</Window>
