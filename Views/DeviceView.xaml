<UserControl x:Class="QC_Management.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:QC_Management.Views"
             mc:Ignorable="d" 
              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"  
             TextElement.FontWeight="Regular" 
             TextElement.FontSize="13"  
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}"
             DataContext="{StaticResource DeviceVM}"
             >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}">
            </i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <materialDesign:Card Grid.Row="0" Grid.Column="0" Margin="5">
            <WrapPanel Margin="0 0 0 10">
                <ComboBox 
                        Name="cbTest"
                        Margin="5 5 15 -14"
                        ItemsSource="{Binding CategorytList}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Category"
                        materialDesign:HintAssist.HintOpacity=".26"
                        IsEditable="True" VerticalAlignment="Top" Width="137" Height="37">

                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding CategorySelectionChangedCommand}">
                            </i:InvokeCommandAction>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ComboBox>

                <TextBox VerticalAlignment="Center"
                             materialDesign:HintAssist.Hint="Tên thiết bị"
                             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             Style="{StaticResource MaterialDesignFilledTextBox}"
                             TextWrapping="Wrap" Height="43" Width="120" />

            </WrapPanel>
        </materialDesign:Card>
        <materialDesign:Card Grid.Row="1" Grid.Column="0" Margin="5">
            <WrapPanel>
                <Button Command="{Binding AddCommand}" Content="Thêm" Margin="5" Width="100"/>
                <Button Command="{Binding DeleteCommand}" Content="Xóa" Margin="5" Width="100"/>
                <Button Command="{Binding EditCommand}" Content="Sửa" Margin="5" Width="100"/>
            </WrapPanel>
        </materialDesign:Card>
        <materialDesign:Card Grid.Row="2" Grid.Column="0" Margin="5" VerticalAlignment="Stretch">
            <ListView ItemsSource="{Binding List}" SelectedItem="{Binding SelectedItem, Mode=OneWayToSource}">

                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding DeviceSelectionChangedCommand}">
                        </i:InvokeCommandAction>
                    </i:EventTrigger>
                </i:Interaction.Triggers>

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="30"/>
                        <GridViewColumn Header="Tên thiết bị" DisplayMemberBinding="{Binding Name}" Width="100"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1" Grid.Column="1" Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <TextBlock Text="Danh mục xét nghiệm thực hiện"></TextBlock>
        </materialDesign:Card>
        
        <materialDesign:DialogHost Grid.Column="1" Grid.Row="2"
                                   DialogTheme="Inherit"
                                   DialogContentUniformCornerRadius="20">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel
                    Margin="16">
                    <TextBlock
                        Text="Add new Test" />
                    <ComboBox ItemsSource="{Binding TestList}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedTest}"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Stretch" />
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,8,8,0"
                            Command="{Binding AddTestCommand}"
                            Content="ACCEPT"
                            IsDefault="True"
                            Style="{StaticResource MaterialDesignFlatButton}">
                        </Button>
                        <Button
                            Margin="0,8,8,0"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            Content="CANCEL"
                            IsCancel="True"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.CommandParameter>
                                <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">
                                    False
                                </system:Boolean>
                            </Button.CommandParameter>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>
            <Border Grid.Column="1" Grid.Row="2"
                        MinHeight="256"
                        BorderBrush="{DynamicResource PrimaryHueMidBrush}" 
                        BorderThickness="1"
                        ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView Grid.RowSpan="2" Grid.Row="0" ItemsSource="{Binding DeviceTestList}" SelectedItem="{Binding SelectedDeviceTest}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IdTestNavigation.Name}"></TextBlock>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <materialDesign:ColorZone Grid.Column="0"
                                                  Effect="{DynamicResource MaterialDesignShadowDepth5}"
                                                  Mode="PrimaryMid" Height="38" Margin="0,278,0,0">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Margin="0,0,8,2"
                                    Text="Insert Test" Height="19" VerticalAlignment="Bottom" />
                            </materialDesign:ColorZone>
                        <Button Grid.Column="0"
                                Margin="0,0,14,26"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}"
                                Content="{materialDesign:PackIcon Kind=Plus}"
                                Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryButton}" />
                        <materialDesign:ColorZone
                            HorizontalAlignment="Stretch"
                            Background="OrangeRed"
                            Grid.Column="1"
                            Effect="{DynamicResource MaterialDesignShadowDepth5}"       
                            Mode="SecondaryMid" Height="38" Margin="0,278,0,0">
                            <TextBlock
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Right"
                                Margin="0,0,8,2"
                                Text="Remove test" Height="19"/>
                        </materialDesign:ColorZone>
                        <Button Grid.Column="1"
                                Margin="0,0,14,26"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="OrangeRed"
                                Command="{Binding RomoveCommand}"
                                Content="{materialDesign:PackIcon Kind=Remove}"
                                Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryButton}" />
                    </Grid>

                </Grid>
            </Border>
        </materialDesign:DialogHost>
    </Grid>
</UserControl>