<UserControl x:Class="QC_Management.Views.CAL_InforView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
 xmlns:local="clr-namespace:QC_Management.Views"
 mc:Ignorable="d" 
 xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
 TextElement.Foreground="{DynamicResource MaterialDesignBody}"
 TextElement.FontWeight="Regular"
 TextElement.FontSize="13"
 TextOptions.TextFormattingMode="Ideal"
 TextOptions.TextRenderingMode="Auto"
 Background="{DynamicResource MaterialDesignPaper}"
 FontFamily="{DynamicResource MaterialDesignFont}"
 DataContext="{StaticResource CalInforVM}"
 d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Status badge style (same look as QC screen) -->
        <Style x:Key="StatusBadge" TargetType="ContentControl">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FF9E9E9E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- True -> show "Hoạt động" (or customize to preferred wording) -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Content}" Value="True">
                    <Setter Property="Background" Value="#2E7D32"/> <!-- green -->
                    <Setter Property="Content" Value="Hoạt động"/>
                </DataTrigger>
                <!-- False -> show "Không hoạt động" -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Content}" Value="False">
                    <Setter Property="Background" Value="#F44336"/> <!-- red -->
                    <Setter Property="Content" Value="Không hoạt động"/>
                </DataTrigger>
                <!-- Null -> show "Không rõ" -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Content}" Value="{x:Null}">
                    <Setter Property="Background" Value="#9E9E9E"/>
                    <Setter Property="Content" Value="Không rõ"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Reuse existing material styles if available -->
    </UserControl.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}">
            </i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="70" CornerRadius="10" Background="#FF1F2937" Padding="12" Margin="5">
            <DockPanel>
                <TextBlock Text="Thông tin Calib" Foreground="White" FontSize="20" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.7*"></ColumnDefinition>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Cal infor master -->
            <Grid Grid.Column="0" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <materialDesign:Card Grid.Row="0" Margin="5">
                    <WrapPanel Margin="5">
                        <ComboBox DisplayMemberPath="CalTypeName"
                                  Margin="5"
                                  ItemsSource="{Binding CalibTypeList}"
                                  SelectedItem="{Binding SelectedCalibType}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  IsEditable="True"
                                  Width="135" Height="50">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding CalTypeSelectionChangedCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>
                        <TextBox Margin="5" VerticalAlignment="Center" materialDesign:HintAssist.Hint="LOT" Text="{Binding CALLOT}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="140" Height="50"/>
                        <DatePicker Margin="5" SelectedDate="{Binding CALExpirationDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Width="140" />
                        <!-- New checkbox for CalInfor.Status -->
                        <CheckBox Margin="5" VerticalAlignment="Center" Content="Active" IsChecked="{Binding CALInfoIsEnable}" />
                    </WrapPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="1" Margin="5">
                    <WrapPanel>
                        <Button Command="{Binding CALAddCommand}" Content="Thêm" Margin="5" Width="100" Background="#6B46C1" Foreground="White"/>
                        <Button Command="{Binding CALDeleteCommand}" Content="Xóa" Margin="5" Width="100" Background="#D32F2F" Foreground="White"/>
                        <Button Command="{Binding CALEditCommand}" Content="Sửa" Margin="5" Width="100" Background="#1976D2" Foreground="White"/>
                    </WrapPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="2" Margin="5" VerticalAlignment="Stretch">
                    <ListView ItemsSource="{Binding CALList}" SelectedItem="{Binding SelectedCalInfo, Mode=TwoWay}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Id" Width="40" DisplayMemberBinding="{Binding Id}"/>
                                <GridViewColumn Header="LOT" Width="120" DisplayMemberBinding="{Binding CalLot}"/>
                                <GridViewColumn Header="Hạn sử dụng" Width="120" DisplayMemberBinding="{Binding ExpirationDate,StringFormat=dd/MM/yyyy}"/>
                                <!-- Status badge column -->
                                <GridViewColumn Header="Status" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Style="{StaticResource StatusBadge}" Content="{Binding Status}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </materialDesign:Card>
            </Grid>

            <Border Grid.Column="1" Background="#FFECECEC"/>

            <!-- RIGHT: Cal detail area (device/test/level filter + editor + list) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0" Margin="5">
                    <TextBlock Text="Danh sách CalDetail cho LOT đã chọn" FontWeight="SemiBold" Margin="6"/>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="1" Margin="5">
                    <WrapPanel Margin="5">
                        <ComboBox DisplayMemberPath="Name" Margin="5" ItemsSource="{Binding DeviceList}" SelectedItem="{Binding SelectedDevice}" Style="{StaticResource MaterialDesignOutlinedComboBox}" IsEditable="True" Width="140" Height="50">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding DeviceSelectionChangedCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>

                        <ComboBox Margin="5" ItemsSource="{Binding TestList}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTest}" Style="{StaticResource MaterialDesignOutlinedComboBox}" IsEditable="True" Width="140" Height="50"/>
                        <TextBox Margin="5"
                                 VerticalAlignment="Center"
                                 materialDesign:HintAssist.Hint="Level"
                                 Text="{Binding SelectedLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Width="120" Height="50"/>
                        <TextBox Margin="5" VerticalAlignment="Center" materialDesign:HintAssist.Hint="Min" Text="{Binding Min}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="120" Height="50"/>
                        <TextBox Margin="5" VerticalAlignment="Center" materialDesign:HintAssist.Hint="Max" Text="{Binding Max}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="120" Height="50"/>
                        <CheckBox Content="Kích hoạt" IsChecked="{Binding CALIsEnable}" VerticalAlignment="Center" Margin="8,0"/>
                    </WrapPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="2" Margin="5">
                    <WrapPanel>
                        <Button Content="Thêm" Width="110" Margin="5" Command="{Binding CalDetailAddCommand}" Background="#6B46C1" Foreground="White"/>
                        <Button Content="Cập nhật" Width="110" Margin="5" Command="{Binding CalDetailEditCommand}" Background="#1976D2" Foreground="White"/>
                        <Button Content="Xóa" Width="110" Margin="5" Command="{Binding CalDetailDeleteCommand}" Background="#D32F2F" Foreground="White"/>
                        <Button Content="Làm mới" Width="110" Margin="5" Command="{Binding LoadedCommand}" Background="#9E9E9E" Foreground="White"/>
                    </WrapPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="3" Margin="5" VerticalAlignment="Stretch">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListView ItemsSource="{Binding CalDetail_List}" SelectedItem="{Binding SelectedCalDetail, Mode=TwoWay}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Device" Width="140" DisplayMemberBinding="{Binding IdDeviceNavigation.Name}"/>
                                    <GridViewColumn Header="Test" Width="140" DisplayMemberBinding="{Binding IdTestNavigation.Name}"/>
                                    <GridViewColumn Header="Level" Width="90" DisplayMemberBinding="{Binding Level}"/>
                                    <GridViewColumn Header="Min" Width="100" DisplayMemberBinding="{Binding MinValue}"/>
                                    <GridViewColumn Header="Max" Width="100" DisplayMemberBinding="{Binding MaxValue}"/>
                                    <GridViewColumn Header="LOT Cal" Width="120" DisplayMemberBinding="{Binding IdCalInforNavigation.CalLot}"/>
                                    <!-- Active -> StatusBadge -->
                                    <GridViewColumn Header="Active" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource StatusBadge}" Content="{Binding Status}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </ScrollViewer>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
