<UserControl x:Class="QC_Management.Views.QC_DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QC_Management.Views"
             mc:Ignorable="d" 
              xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        DataContext="{StaticResource QC_DetailVM}"
        Name="Objectview" d:DesignHeight="600" d:DesignWidth="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}">
            </i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <!--các element binding từ selected item-->
            <materialDesign:Card Grid.Row="0" Margin="5">
                <WrapPanel Margin="5">
                    <ComboBox
                        DisplayMemberPath="Name"
                        Margin="5"
                        ItemsSource="{Binding DeviceList}"
                        SelectedItem="{Binding SelectedDevice}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Deivce"
                        Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                        IsEditable="True" Width="132" Height="42">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding DeviceSelectionChangedCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <ComboBox
                        Margin="5"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding ListType}"
                        SelectedItem="{Binding SelectedType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Loại QC"
                        Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                        materialDesign:HintAssist.HintOpacity=".26"
                        IsEditable="True" Height="42" Width="129">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding QCTypeSelectionChangedCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <ComboBox
                        ItemsSource="{Binding ControlInfoList}"
                        SelectedItem="{Binding SelectedControlInfo}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="QC Infor"
                        Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                        IsEditable="True" Width="201" Height="42">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding QC_InfoSelectionChangedCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"></TextBlock>
                                    <TextBlock Text=" - "></TextBlock>
                                    <TextBlock Text="{Binding Lot}"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                    </ComboBox>

                    <ComboBox
                        Margin="5"
                        ItemsSource="{Binding TestList}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedTest, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Xét nghiệm"
                        Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                        IsEditable="True" Width="132" Height="42">

                    </ComboBox>

                    <ComboBox
                        Margin="5"
                        ItemsSource="{Binding LevelList}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Level"
                        materialDesign:HintAssist.HintOpacity=".26"
                        Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                        IsEditable="True" Width="78" Height="42"/>

                    <TextBox
                        Margin="5"
                        VerticalAlignment="Center"   
                        materialDesign:HintAssist.Hint="LOT"  
                        Text="{Binding LOT}"
                        AcceptsReturn="True"
                        Style="{StaticResource MaterialDesignFilledTextBox}"
                        TextWrapping="Wrap" Width="auto" Height="42" />

                    <TextBox
                        Margin="5"
                             VerticalAlignment="Center" 
                             materialDesign:HintAssist.Hint="Mean NSX"
                             Text="{Binding MeanNSX}"
                             AcceptsReturn="True"
                             Style="{StaticResource MaterialDesignFilledTextBox}"
                             TextWrapping="Wrap" Width="auto" Height="42" />
                    <TextBox
                        Margin="5"
                             VerticalAlignment="Center" 
                             materialDesign:HintAssist.Hint="SD NSX"
                             Text="{Binding SDNSX}"
                             AcceptsReturn="True"
                             Style="{StaticResource MaterialDesignFilledTextBox}"
                             TextWrapping="Wrap" Width="auto" Height="42"/>
                    <TextBox
                        Margin="5"
                             VerticalAlignment="Center" 
                             materialDesign:HintAssist.Hint="Mean PXN"
                             Text="{Binding MeanPXN}"
                             AcceptsReturn="True"
                             Style="{StaticResource MaterialDesignFilledTextBox}"
                             TextWrapping="Wrap" Width="auto" Height="42" />
                    <TextBox
                        Margin="5"
                             VerticalAlignment="Center" 
                             materialDesign:HintAssist.Hint="SD PXN"
                             Text="{Binding SdPXN}"
                             AcceptsReturn="True"
                             Style="{StaticResource MaterialDesignFilledTextBox}"
                             TextWrapping="Wrap" Width="auto" Height="42"/>
                    <TextBox
     Margin="5"
          VerticalAlignment="Center" 
          materialDesign:HintAssist.Hint="Current Mean"
          Text="{Binding CurMean}"
          AcceptsReturn="True"
          Style="{StaticResource MaterialDesignFilledTextBox}"
          TextWrapping="Wrap" Width="auto" Height="42" />
                    <TextBox
     Margin="5"
          VerticalAlignment="Center" 
          materialDesign:HintAssist.Hint="Current Sd"
          Text="{Binding CurSd}"
          AcceptsReturn="True"
          Style="{StaticResource MaterialDesignFilledTextBox}"
          TextWrapping="Wrap" Width="auto" Height="42"/>
                    <CheckBox
                            Content="Kích hoạt"
                            IsChecked="{Binding IsChecked}"
                            />

                </WrapPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="1" Margin="5">
                <WrapPanel>
                    <Button Command="{Binding AddCommand}" Content="Thêm" Margin="5" Width="100"></Button>
                    <Button Command="{Binding DeleteCommand}" Content="Xóa" Margin="5" Width="100"></Button>
                    <Button Command="{Binding EditCommand}" Content="Sửa" Margin="5" Width="100"></Button>
                </WrapPanel>

            </materialDesign:Card>

            <materialDesign:Card Grid.Row="2" Margin="5" VerticalAlignment="Stretch">
                <ListView ItemsSource="{Binding List,Mode=TwoWay}" SelectedItem="{Binding SelectedItem}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Test" Width="100" DisplayMemberBinding="{Binding IdTestNavigation.Name}"/>
                            <GridViewColumn Header="QC" Width="100" DisplayMemberBinding="{Binding IdControlInfoNavigation.Name}"/>
                            <GridViewColumn Header="LOT" Width="80" DisplayMemberBinding="{Binding Lot}"/>
                            <GridViewColumn Header="Level" Width="80" DisplayMemberBinding="{Binding IdLevelNavigation.Name}"/>
                            <GridViewColumn Header="MeanNSX" Width="80" DisplayMemberBinding="{Binding MeanNsx}"/>
                            <GridViewColumn Header="SDNSX" Width="80" DisplayMemberBinding="{Binding SdNsx}"/>
                            <GridViewColumn Header="MeanPXN" Width="80" DisplayMemberBinding="{Binding MeanApp}"/>
                            <GridViewColumn Header="SDPXN" Width="50" DisplayMemberBinding="{Binding SdApp}"/>
                            <GridViewColumn Header="Current Mena" Width="80" DisplayMemberBinding="{Binding CurMean}"/>
                            <GridViewColumn Header="Current Sd" Width="50" DisplayMemberBinding="{Binding CurSd}"/>
                            <GridViewColumn Header="Active" Width="50" DisplayMemberBinding="{Binding Status}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>

