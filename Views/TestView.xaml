<UserControl x:Class="QC_Management.Views.TestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QC_Management.Views"
             mc:Ignorable="d" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        DataContext="{StaticResource TestVM}"
        Name="Objectview" d:DesignHeight="600" d:DesignWidth="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}">
            </i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <UserControl.Resources>
        <CollectionViewSource x:Key="Collection2View" Source="{Binding DeviceList}" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.8*"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <!--các element binding từ selected item-->
                <materialDesign:Card Grid.Row="0" Margin="5">
                    <WrapPanel Margin="0 0 0 5">
                        <TextBox VerticalAlignment="Top" HorizontalAlignment="Stretch"
                             materialDesign:HintAssist.Hint="Nhóm xét nghiệm"
                             Text="{Binding CategoryDisplayName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="5 5 15 5"
                             AcceptsReturn="True"
                             Style="{StaticResource MaterialDesignFilledTextBox}"
                             TextWrapping="Wrap" />
                    </WrapPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="1" Margin="5">
                    <WrapPanel>
                        <Button Command="{Binding CategoryAddCommand}" Content="Thêm nhóm" Margin="5" Width="110"/>
                        <Button Command="{Binding CategoryDeleteCommand}" Content="Xóa nhóm" Margin="5" Width="100"/>
                        <Button Command="{Binding CategoryEditCommand}" Content="Update" Margin="5" Width="100"/>
                    </WrapPanel>

                </materialDesign:Card>

                <materialDesign:Card Grid.Row="2" Margin="5" VerticalAlignment="Stretch">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListView ItemsSource="{Binding CategoryList}" SelectedItem="{Binding SelectedCategory, Mode=OneWayToSource}" Height="auto" d:ItemsSource="{d:SampleData ItemCount=5}">

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding CategoryChangedCommand}">
                                    </i:InvokeCommandAction>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Id" Width="50" DisplayMemberBinding="{Binding Id}"/>
                                    <GridViewColumn Header="Tên hiển thị" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </ScrollViewer>
                </materialDesign:Card>
            </Grid>
        </Grid>

        <Grid Grid.Column="1">
            <Grid Grid.Column="0" Margin="0,0,0,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <!--các element binding từ selected item-->
                <materialDesign:Card Grid.Row="0" Margin="5">
                    <WrapPanel Margin="0 0 0 5">
                        <ComboBox
                            ItemsSource="{Binding CategoryByTestList}"
                            DisplayMemberPath="Name"
                            SelectedItem="{Binding SelectedCategoryByTest, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:ComboBoxAssist.MaxLength="2"
                            materialDesign:HintAssist.Hint="Nhóm xét nghiệm"
                            materialDesign:HintAssist.HintOpacity=".26"
                            IsEditable="True" Height="42"/>

                        <TextBox VerticalAlignment="Top" HorizontalAlignment="Stretch"
                             materialDesign:HintAssist.Hint="Index"
                             Text="{Binding Index, UpdateSourceTrigger=PropertyChanged}"
                             Margin="5"
                             AcceptsReturn="True"
                             Style="{StaticResource MaterialDesignFilledTextBox}"
                             TextWrapping="Wrap" />
                        <TextBox VerticalAlignment="Top" HorizontalAlignment="Stretch"
                             materialDesign:HintAssist.Hint="Tên xét nghiệm"
                             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="5 5 5 5"
                             AcceptsReturn="True"
                             Style="{StaticResource MaterialDesignFilledTextBox}"
                             TextWrapping="Wrap" />
                        <ComboBox
                        ItemsSource="{Binding UnitList}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedUnitTable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Đơn vị tính"
                        materialDesign:HintAssist.HintOpacity=".26"
                        IsEditable="True" Height="42"/>

                    </WrapPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="1" Margin="5">
                    <WrapPanel>
                        <Button Command="{Binding AddCommand}" Content="Thêm Test" Margin="5" Width="100"></Button>
                        <Button Command="{Binding DeleteCommand}" Content="Xóa Test" Margin="5" Width="100"></Button>
                        <Button Command="{Binding EditCommand}" Content="Update" Margin="5" Width="100"></Button>
                        <Button Command="{Binding RefreshCommand}" Content="Refresh" Width="100"/>
                    </WrapPanel>

                </materialDesign:Card>

                <materialDesign:Card Grid.Row="2" Margin="5" VerticalAlignment="Stretch">
                    <ListView ItemsSource="{Binding List}" SelectedItem="{Binding SelectedItem, Mode=OneWayToSource}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="STT" Width="50" DisplayMemberBinding="{Binding Index}"/>
                                <GridViewColumn Header="Tên xét nghiệm" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Đơn vị" Width="100" DisplayMemberBinding="{Binding IdUnitTableNavigation.Name}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </materialDesign:Card>
            </Grid>

        </Grid>


    </Grid>
</UserControl>

