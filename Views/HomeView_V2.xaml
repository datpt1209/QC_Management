                Width="200" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"  Panel.ZIndex="2"/>
            <materialDesign:Card Margin="5" Panel.ZIndex="0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <lvc:CartesianChart 
                        x:Name="chart" Width="{Binding totalWidth1}"
                        HorizontalAlignment="Left"
                        Visibility="{Binding Visibility1}">
                        <lvc:CartesianChart.Series>
                            <lvc:LineSeries 
                                DataLabels="False"
                                PointGeometry="{x:Null}"
                                Title="3SD" 
                                StrokeThickness="3"
                                Values="{Binding PlusThreeSDValues1}"
                                Stroke="Red"
                                Fill="Transparent"/>

                            <lvc:LineSeries 
                                DataLabels="False"
                                PointGeometry="{x:Null}"
                                StrokeThickness="3"
                                Title="+2SD" 
                                Values="{Binding PlusTwoSDValues1}" 
                                Stroke="Orange" 
                                Fill="Transparent"
                                IsHitTestVisible="False"/>

                            <lvc:LineSeries 
                                DataLabels="False"
                                PointGeometry="{x:Null}" 
                                StrokeThickness="3"
                                Title="1SD" 
                                Values="{Binding PlusOneSDValues1}"
                                Stroke="Green" 
                                Fill="#FFC4EEB4"
                                IsHitTestVisible="False"/>

                            <lvc:LineSeries 
                                Title="Mean" 
                                StrokeThickness="3"
                                Values="{Binding MeanValues1}"
                                Stroke="Green"
                                PointGeometry="{x:Null}"
                                DataLabels="False" 
                                Fill="Transparent"
                                IsHitTestVisible="False"/>

                            <lvc:LineSeries 
                                DataLabels="False"
                                PointGeometry="{x:Null}"
                                StrokeThickness="3"
                                Title="-1SD" 
                                Values="{Binding MinusOneSDValues1}"
                                Stroke="Green" 
                                Fill="White"
                                IsHitTestVisible="False"/>

                            <lvc:LineSeries 
                                DataLabels="False"
                                PointGeometry="{x:Null}"
                                Title="-2SD" 
                                StrokeThickness="3"
                                Values="{Binding MinusTwoSDValues1}"
                                Stroke="Orange"
                                Fill="Transparent"/>

                            <lvc:LineSeries 
                                DataLabels="False"
                                PointGeometry="{x:Null}"
                                Title="-3SD" 
                                StrokeThickness="3"
                                Values="{Binding MinusThreeSDValues1}"
                                Stroke="Red"
                                Fill="Transparent"/>

                            <lvc:LineSeries
                                Title="result"
                                StrokeThickness="4" 
                                Stroke="#1C8FC5" 
                                Fill="Transparent"
                                LineSmoothness="0" 
                                PointGeometrySize="15" 
                                PointForeground="#222E31"
                                Values="{Binding ChartValues1}">
                            </lvc:LineSeries>
                        </lvc:CartesianChart.Series>

                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Labels="{Binding Dates1}">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="1">
                                    </lvc:Separator>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>

                        <lvc:CartesianChart.DataTooltip>
                            <local:CustomersTooltip SelectedFilter="{Binding SelectedFilterOptions}" />
                        </lvc:CartesianChart.DataTooltip>


                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis LabelFormatter="{Binding YAxisLabelFormatter}" MaxValue="4" MinValue="-4">
                                <lvc:Axis.Separator>
                                    <lvc:Separator 
                                            StrokeThickness="0.5" 
                                            Step="1">
                                        <lvc:Separator.Stroke>
                                            <SolidColorBrush Color="#FF151F23">
                                            </SolidColorBrush>
                                        </lvc:Separator.Stroke>
                                    </lvc:Separator>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </ScrollViewer>
            </materialDesign:Card>
