                                                    <lvc:Separator 
StrokeThickness="0.5" 
 Step="1">
                                                        <lvc:Separator.Stroke>
                                                            <SolidColorBrush Color="#FF151F23">
                                                            </SolidColorBrush>
                                                        </lvc:Separator.Stroke>
