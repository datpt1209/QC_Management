<UserControl x:Class="QC_Management.Views.HomeView_V2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QC_Management.Views"
             mc:Ignorable="d"          
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf" xmlns:viewmodels="clr-namespace:QC_Management.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:HomeViewModel_V2}"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             SizeChanged="HomeView_SizeChanged"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}"
             DataContext="{StaticResource HomeViewVM_V2}"
             x:Name="HomeView" d:DesignHeight="600" d:DesignWidth="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}">
            </i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"></ColumnDefinition>
            <ColumnDefinition ></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Column="0" Grid.ColumnSpan="3" Grid.Row ="0">
            <materialDesign:Card  Margin="5">
                <WrapPanel Margin="5">
                    <ComboBox 
                        Margin="5"
                        ItemsSource="{Binding DeviceList}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Thiết bị"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        IsEditable="True" VerticalAlignment="Top" Width="150" Height="50">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding DeviceSelectionChangedCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>

                    <DatePicker       
                        Margin="5"
                        SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"   
                        materialDesign:HintAssist.Hint="Ngày bắt đầu" 
                        materialDesign:TextFieldAssist.HasClearButton="True"  
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        Width="140" Height="50">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectedDateChanged">
                                <i:InvokeCommandAction Command="{Binding DateSelectionChangedCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </DatePicker>
                    <DatePicker          
                        Margin="5"
                        SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"      
                        materialDesign:HintAssist.Hint="Ngày kết thúc"       
                        materialDesign:TextFieldAssist.HasClearButton="True"   
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        Width="140" Height="50">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectedDateChanged">
                                <i:InvokeCommandAction Command="{Binding DateSelectionChangedCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                    </DatePicker>
                    <ListBox
                        Margin="5"
                        VerticalAlignment="Center"
                        x:Name="RadioButtonGroupChoiceChipAccentOutline"
                        SelectedItem="{Binding SelectedFilterOptions, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding FilterOptions}"
                        SelectionMode="Single"
                        Style="{StaticResource MaterialDesignChoiceChipPrimaryListBox}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SeenChartTypeSelectionChangedCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ListBox>
                    <Button Command="{Binding PrintCommand}" Content="In QC"  Margin="5" Width="100"/>
                    <Button Command="{Binding PrintChartCommand}" Content="In Biểu đồ"  Margin="5" Width="100"/>
                    <Button Command="{Binding PrintCalibCommand}" Content="In Calib"  Margin="5" Width="100"/>
                </WrapPanel>
            </materialDesign:Card>
        </Grid>

        <Grid Grid.Column="0" Grid.Row="1" Grid.RowSpan="3">
            <materialDesign:Card Grid.Row="2" Grid.Column="0" Margin="5" VerticalAlignment="Stretch">
                <materialDesign:Card.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="3"/>
                        <Setter Property="Background" Value="#FFE0E0E0"/>
                    </Style>
                </materialDesign:Card.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListView  
                        ItemsSource="{Binding TestList}" 
                        DisplayMemberPath="Name" 
                        SelectedItem="{Binding SelectedTest, Mode=TwoWay}" 
                        d:ItemsSource="{d:SampleData ItemCount=5}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding TestSelectionChangedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ListView>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>

        <Grid Grid.Column="1" Grid.Row="1">
            <materialDesign:Card Margin="5,5,5,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Visibility="{Binding Visibility1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:Card Margin="5" Grid.Row="0">
                                <ScrollViewer  HorizontalScrollBarVisibility="Auto">
                                    <lvc:CartesianChart 
                                        Height="{Binding ChartHeight}"
                                        x:Name="chart" Width="{Binding totalWidth1}"
                                        HorizontalAlignment="Left">
                                        <lvc:CartesianChart.Series>
                                            <lvc:LineSeries 
                                                DataLabels="False"
                                                PointGeometry="{x:Null}"
                                                Title="3SD" 
                                                StrokeThickness="3"
                                                Values="{Binding PlusThreeSDValues1}"
                                                Stroke="Red"
                                                Fill="Transparent"/>
                                            <lvc:LineSeries 
                                                DataLabels="False"
                                                PointGeometry="{x:Null}"
                                                StrokeThickness="3"
                                                Title="+2SD" 
                                                Values="{Binding PlusTwoSDValues1}" 
                                                Stroke="Orange" 
                                                Fill="Transparent"
                                                IsHitTestVisible="False"/>

                                            <lvc:LineSeries 
                                            DataLabels="False"
                                            PointGeometry="{x:Null}" 
                                            StrokeThickness="3"
                                            Title="1SD" 
                                            Values="{Binding PlusOneSDValues1}"
                                            Stroke="Green" 
                                            Fill="#FFC4EEB4"
                                            IsHitTestVisible="False"/>

                                            <lvc:LineSeries 
                                            Title="Mean" 
                                            StrokeThickness="3"
                                            Values="{Binding MeanValues1}"
                                            Stroke="Green"
                                            PointGeometry="{x:Null}"
                                            DataLabels="False" 
                                            Fill="Transparent"
                                            IsHitTestVisible="False"/>
                                            <lvc:LineSeries 
DataLabels="False"
PointGeometry="{x:Null}"
StrokeThickness="3"
Title="-1SD" 
Values="{Binding MinusOneSDValues1}"
Stroke="Green" 
Fill="White"
IsHitTestVisible="False"/>

                                            <lvc:LineSeries 
DataLabels="False"
PointGeometry="{x:Null}"
Title="-2SD" 
StrokeThickness="3"
Values="{Binding MinusTwoSDValues1}"
Stroke="Orange"
Fill="Transparent"/>

                                            <lvc:LineSeries 
DataLabels="False"
PointGeometry="{x:Null}"
Title="-3SD" 
StrokeThickness="3"
Values="{Binding MinusThreeSDValues1}"
Stroke="Red"
Fill="Transparent"/>

                                            <lvc:LineSeries
                                            Title="result"
                                            StrokeThickness="4" 
                                            Stroke="#1C8FC5" 
                                            Fill="Transparent"
                                            LineSmoothness="0" 
                                            PointGeometrySize="15" 
                                            PointForeground="#222E31"
                                            Values="{Binding ChartValues1}">
                                            </lvc:LineSeries>
                                        </lvc:CartesianChart.Series>

                                        <lvc:CartesianChart.AxisX>
                                            <lvc:Axis Labels="{Binding Dates1}">
                                                <lvc:Axis.Separator>
                                                    <lvc:Separator Step="1">
                                                    </lvc:Separator>
                                                </lvc:Axis.Separator>
                                            </lvc:Axis>
                                        </lvc:CartesianChart.AxisX>

                                        <lvc:CartesianChart.DataTooltip>
                                            <local:CustomersTooltip SelectedFilter="{Binding SelectedFilterOptions}" />
                                        </lvc:CartesianChart.DataTooltip>

                                        <lvc:CartesianChart.AxisY>
                                            <lvc:Axis LabelFormatter="{Binding YAxisLabelFormatter}" MaxValue="4" MinValue="-4">
                                                <lvc:Axis.Separator>
                                                    <lvc:Separator 
                                                    StrokeThickness="0.5" 
                                                    Step="1">
                                                        <lvc:Separator.Stroke>
                                                            <SolidColorBrush Color="#FF151F23">
                                                            </SolidColorBrush>
                                                        </lvc:Separator.Stroke>
                                                    </lvc:Separator>
                                                </lvc:Axis.Separator>
                                            </lvc:Axis>
                                        </lvc:CartesianChart.AxisY>
                                    </lvc:CartesianChart>
                                </ScrollViewer>
                            </materialDesign:Card>
                            <materialDesign:Card Margin="5" Grid.Column="1">
                                <StackPanel  Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock>
                                        <Run Text="N: " FontWeight="Bold"/>
                                        <Run Text="{Binding TotalPoints1}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Level: " FontWeight="Bold"/>
                                        <Run Text="{Binding LevelName1}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Mean: " FontWeight="Bold"/>
                                        <Run Text="{Binding Mean1}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="SD: " FontWeight="Bold"/>
                                        <Run Text="{Binding SD1}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Range: " FontWeight="Bold"/>
                                         <LineBreak/>
                                        <Run Text="{Binding Range1}"/>
                                    </TextBlock>
                                </StackPanel>
                            </materialDesign:Card>
