<UserControl x:Class="QC_Management.Views.ExternalResultReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             MinHeight="400" MinWidth="700">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" CornerRadius="8" Background="#FF1F2937" Padding="12" Margin="6">
            <TextBlock Text="Xem kết quả ngoại kiểm" Foreground="White" FontSize="18" FontWeight="Bold"/>
        </Border>

        <!-- Filters -->
        <Border Grid.Row="1" CornerRadius="6" Background="White" Padding="10" Margin="6,0,6,6" BorderBrush="#FFE0E6EE" BorderThickness="1">
            <WrapPanel VerticalAlignment="Center">
                <ComboBox Width="220" Margin="6,0"
                          ItemsSource="{Binding Programs}"
                          SelectedItem="{Binding SelectedProgram}"
                          DisplayMemberPath="Name"
                          ToolTip="Chương trình"/>

                <ComboBox Width="220" Margin="6,0"
                          ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="Name"
                          ToolTip="Thiết bị"/>

                <ComboBox Width="300" Margin="6,0"
                          ItemsSource="{Binding Tests}"
                          SelectedItem="{Binding SelectedTest}"
                          DisplayMemberPath="Name"
                          ToolTip="Xét nghiệm"/>

                <DatePicker Width="140" Margin="6,0"
                            SelectedDate="{Binding FromDate}"
                            ToolTip="Từ ngày"/>

                <DatePicker Width="140" Margin="6,0"
                            SelectedDate="{Binding ToDate}"
                            ToolTip="Đến ngày"/>

                <Button Content="Load" Width="90" Margin="12,0,0,0" Command="{Binding LoadCommand}"/>
                <Button Content="Refresh" Width="90" Margin="6,0,0,0" Command="{Binding RefreshCommand}"/>
                <Button Content="Export CSV" Width="110" Margin="6,0,0,0" Command="{Binding ExportCsvCommand}"/>
            </WrapPanel>
        </Border>

        <!-- Results grid -->
        <Border Grid.Row="2" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1" Padding="6" Background="White" Margin="6">
            <DataGrid ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Đợt"
                                        Binding="{Binding Batch}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Ngày"
                                        Binding="{Binding DateRun, StringFormat=g}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Chương trình"
                                        Binding="{Binding ExternalProgramName, Mode=OneWay}"
                                        IsReadOnly="True"
                                        Width="150"/>

                    <DataGridTextColumn Header="Thiết bị"
                                        Binding="{Binding DeviceName, Mode=OneWay}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Xét nghiệm"
                                        Binding="{Binding TestName, Mode=OneWay}"
                                        Width="200"/>

                    <DataGridTextColumn Header="Kết quả"
                                        Binding="{Binding TempResult}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Giá trị ấn định"
                                        Binding="{Binding ReferenceValue}"
                                        Width="110"/>

                    <DataGridTextColumn Header="σp"
                                        Binding="{Binding SigmaP}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Z-score"
                                        Binding="{Binding ZScore, Mode=OneWay}"
                                        Width="80"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="Ghi chú"
                                        Binding="{Binding Notes}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>