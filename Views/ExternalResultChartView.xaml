<UserControl x:Class="QC_Management.Views.ExternalResultChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QC_Management.Views"
             xmlns:vm="clr-namespace:QC_Management.ViewModels"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             Height="450" Width="900">
    <UserControl.DataContext>
        <vm:ExternalResultChartViewModel />
    </UserControl.DataContext>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center" >
            <TextBlock Text="Program:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox Width="220" ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram}" DisplayMemberPath="Name"/>

            <TextBlock Text="Device:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <ComboBox Width="180" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name"/>

            <TextBlock Text="From:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <DatePicker SelectedDate="{Binding StartDate}" Width="140"/>

            <TextBlock Text="To:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <DatePicker SelectedDate="{Binding EndDate}" Width="140"/>

            <Button Content="Load" Command="{Binding LoadCommand}" Margin="12,0"/>
            <Button Content="Refresh lookups" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <lvc:CartesianChart Grid.Row="1" Series="{Binding SeriesCollection}" LegendLocation="Right" DisableAnimations="True">
            <lvc:CartesianChart.AxisX>
                <lvc:Axis Title="Sample index" Labels="{Binding Labels}" Separator="{x:Null}" />
            </lvc:CartesianChart.AxisX>
            <lvc:CartesianChart.AxisY>
                <lvc:Axis Title="ZScore" LabelFormatter="{Binding YAxisLabelFormatter}" MinValue="-4" MaxValue="4" />
            </lvc:CartesianChart.AxisY>
        </lvc:CartesianChart>
    </Grid>
</UserControl>
