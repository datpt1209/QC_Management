<Window x:Class="QC_Management.Views.Re_CalResultDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QC_Management.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Title="Danh sách CAL" Height="450" Width="800">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}">
            </i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <materialDesign:Card Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBox 
                            Margin="5"
                            Width="150"
                            VerticalAlignment="Center" 
                            materialDesign:HintAssist.Hint="Thiết bị:"
                            Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            TextWrapping="Wrap" Height="50"/>
                        <DatePicker 
                            Margin="5"
                            SelectedDate="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:HintAssist.Hint="Ngày"
                            materialDesign:TextFieldAssist.HasClearButton="True" 
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" Width="128" Height="50" />

                        <materialDesign:TimePicker  
                            Width="140"
                            Margin="5"
                            SelectedTime="{Binding Time}"
                            materialDesign:HintAssist.HelperText="Helper text"
                            materialDesign:HintAssist.Hint="Pick Time"
                            Is24Hours="True"
                            Style="{StaticResource MaterialDesignOutlinedTimePicker}" >

                        </materialDesign:TimePicker>

                    </StackPanel>
                </materialDesign:Card>
            </Grid>
            
            <Grid Grid.Column="1">
                <materialDesign:Card  Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding SaveCommand}" Content="Lưu" Margin="5" Width="100"/>
                        <Button Command="{Binding CancelCommand}" Content="Hủy" Margin="5" Width="100"/>
                        <Button Command="{Binding DeleteCommand}" Content="Xóa" Margin="5" Width="100"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
           
        </Grid>

        <Grid Grid.Row="1">
            <DataGrid Name="input" ItemsSource="{Binding CalResutlViewList}" AutoGenerateColumns="False"
                        SelectedItem="{Binding SelectedItem, Mode=OneWayToSource}"
                        CanUserAddRows="False">
                <DataGrid.Columns >
                    
                    <DataGridTextColumn Header="Xét nghiệm" CanUserSort="False"
                                        Binding="{Binding IdTestNavigation.Name}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Level" Binding="{Binding Level }"
                                        CanUserSort="False" IsReadOnly="True" />
                    <DataGridTextColumn Header="LOT" Binding="{Binding LOT }"
                                        CanUserSort="False" IsReadOnly="True" />
                    <DataGridTextColumn Header="Min" Binding="{Binding Min }"
                                        CanUserSort="False" IsReadOnly="True" />
                    <DataGridTextColumn Header="Max" Binding="{Binding Max }" 
                                        CanUserSort="False" IsReadOnly="True" />
                    <DataGridTextColumn Header="Kết quả" CanUserSort="False" 
                                        IsReadOnly="False" Binding="{Binding Result, Converter= {StaticResource TextCoverter}}">

                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="Green" />
                                <!--Màu mặc định-->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding isOutOfRange}" Value="True">
                                        <Setter Property="Foreground" Value="Red" />
                                        <Setter Property="Background" Value="Yellow" />
                                        <!--Thay đổi màu nền nếu ngoài 3 SD-->
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Ghi chú" Width="auto" IsReadOnly="False" Binding="{Binding Comment}"></DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>