<Window x:Class="QC_Management.Views.CorrectActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="Phiếu khắc phục"
        SizeToContent="Height"
        Width="920"
        WindowStartupLocation="CenterScreen"
        Background="#FFF0F4F8"
        ResizeMode="CanResize">
    <Window.Resources>
        <!-- Tighter input spacing for this window -->
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="8">
            <!-- Card -->
            <Border CornerRadius="10" Background="White" Padding="8" 
                    Effect="{DynamicResource MaterialDesignElevationShadow8}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title + General info (highlighted) -->
                    <Border Grid.Column="0" CornerRadius="8" Padding="12" Margin="6"
                            Background="#F4FBFF" BorderBrush="#BBDEFB" BorderThickness="1">
                        <!-- Local resource: make left-side textblocks and controls a bit more spaced -->
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#90CAF9"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="4"/>
                                    <Setter Property="Foreground" Value="#0D47A1"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Margin" Value="4"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                                <Style TargetType="DatePicker">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#90CAF9"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="Margin" Value="4"/>
                                </Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="0,6,0,6"/>
                                    <Setter Property="FontSize" Value="13"/>
                                </Style>
                            </StackPanel.Resources>

                            <TextBlock Text="PHIẾU KHẮC PHỤC"
                                       FontSize="15" FontWeight="Bold" Foreground="#222" />
                            <TextBlock Text="THÔNG TIN CHUNG" Margin="0,10,0,12" Foreground="#1976D2" FontWeight="SemiBold"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <!-- left column made wider to give labels breathing room -->
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ngày tạo:" VerticalAlignment="Center"/>
                                <!-- Wrapped DatePicker to provide rounded border and vertical centering -->
                                <Border Grid.Row="0" Grid.Column="1"
                                        CornerRadius="6"
                                        Background="#FFFFFF"
                                        BorderBrush="#90CAF9"
                                        BorderThickness="1"
                                        Padding="2"
                                        VerticalAlignment="Center"
                                        Margin="4">
                                    <DatePicker
                                        HorizontalAlignment="Left"
                                        Margin="4" 
                                        SelectedDate="{Binding Date, UpdateSourceTrigger=PropertyChanged}" 
                                        materialDesign:TextFieldAssist.HasClearButton="True" 
                                        Style="{StaticResource MaterialDesignDatePicker}"
                                        Width="240"/>
                                </Border>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Người lập:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Text="{Binding Reporter, Mode=OneWay}" Margin="4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Thiết bị:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" IsReadOnly="True" Text="{Binding DeviceName, Mode=OneWay}" Margin="4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Xét nghiệm:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="3" Grid.Column="1" IsReadOnly="True" Text="{Binding TestName, Mode=OneWay}" Margin="4"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="LOT:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="4" Grid.Column="1" IsReadOnly="True" Text="{Binding SelectedExistingIncident.Lot, Mode=OneWay, TargetNullValue=''}" Margin="4"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Kết quả:" VerticalAlignment="Top"/>
                                <TextBox Grid.Row="5" Grid.Column="1" IsReadOnly="True" Text="{Binding SelectedExistingIncident.ErroneousResult.TempResult, Mode=OneWay, TargetNullValue=''}" Margin="4"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Range tham chiếu:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="6" Grid.Column="1" IsReadOnly="True" Text="{Binding SelectedExistingIncidentRange, Mode=OneWay}" Margin="4"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Lỗi:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="7" Grid.Column="1" IsReadOnly="True" Text="{Binding SelectedExistingIncident.WestgardDescription, Mode=OneWay}"
                                         TextWrapping="Wrap" Height="64" Margin="4"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Right: Handling content (compact spacing) -->
                    <StackPanel Grid.Column="1" Margin="8,6,6,6">
                        <TextBlock Text="NỘI DUNG XỬ LÝ" FontSize="15" FontWeight="Bold" Foreground="#222" />
                        <StackPanel Orientation="Vertical" Margin="0,6,0,0" >

                            <!-- Kết quả khắc phục moved to top and highlighted -->
                            <Border Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,1,0,6">
                                <StackPanel Orientation="Vertical">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Kết quả sau khắc phục:" FontWeight="SemiBold" Foreground="#0D47A1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding ResolvingResults}" SelectedItem="{Binding SelectedResolvingResult}" Margin="0"
                                                  Background="Transparent" Height="28">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DateRun, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Margin="4,0" Foreground="Gray"/>
                                                        <TextBlock Text=" • " Foreground="Gray"/>
                                                        <TextBlock Text="{Binding IndexQc}" Width="60" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text=" (" Foreground="Gray"/>
                                                        <TextBlock Text="{Binding TempResult}" FontWeight="Bold" Foreground="Gray"/>
                                                        <TextBlock Text=")" Foreground="Gray"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="{Binding CorrectiveResultStatus}"
                                               FontWeight="SemiBold" 
                                               HorizontalAlignment="Right"
                                               Margin="2,4,0,6">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCorrectiveResultInRange}" Value="True">
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCorrectiveResultInRange}" Value="False">
                                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Nguyên nhân -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Nguyên nhân:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding CauseCategoryOptions}"
                                          SelectedItem="{Binding SelectedCauseCategory}"
                                          Margin="1"/>
                            </Grid>

                            <!-- Nguyên nhân chi tiết (ComboBox) -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Nguyên nhân chi tiết:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding CauseDetailOptions}"
                                          SelectedItem="{Binding SelectedCauseDetail}"
                                          Margin="1"/>
                            </Grid>

                            <!-- New: TextBox for detailed cause notes (Nguyên nhân chi tiết - ghi chú) -->
                            <TextBlock Text="Ghi chú nguyên nhân:" Margin="0,2,0,2"/>
                            <TextBox Text="{Binding ErrorReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Height="48"
                                     Margin="0,2,0,6"/>

                            <!-- New: Hành động khắc phục (chọn) -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="HĐ khắc phục (chọn):" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding CorrectiveActionOptions}"
                                          SelectedItem="{Binding SelectedAction}"
                                          Margin="1" Height="28"/>
                            </Grid>
                            <!-- Single editable details TextBox (shows corrective action details) -->
                            <TextBlock Text="Hành động khắc phục (chi tiết):" Margin="0,2,0,2"/>
                            <TextBox Text="{Binding CorrectiveAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Height="48"
                                     Margin="0,2,0,6"/>

                            <!-- Hành động phòng ngừa (swapped source) -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                           Text="HĐ phòng ngừa:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ActionOptions}"
                                          SelectedItem="{Binding SelectedPreventiveAction}"
                                          Margin="1" Height="28"/>
                            </Grid>

                            <TextBlock Text="Hành động phòng ngừa (ghi chú):" Margin="0,2,0,2"/>
                            <TextBox Text="{Binding PreventiveAction}"
                                     AcceptsReturn="True" 
                                     TextWrapping="Wrap"
                                     Height="48"
                                     Margin="0,2,0,6"/>

                            
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,6,0,0">
                                <CheckBox IsChecked="{Binding MarkResolved}" Content="Đánh dấu là kết quả khắc phục (link đến Result đã lưu)" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="Lưu" Width="110" Margin="6,0" Command="{Binding SaveCommand}" Background="#1976D2" Foreground="White"/>
                                <Button Content="Hủy" Width="110" Margin="6,0" Command="{Binding CancelCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>