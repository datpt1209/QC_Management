<Window x:Class="QC_Management.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:QC_Management"
        mc:Ignorable="d"
        Name="mainWindow"
        DataContext="{StaticResource MainVM}"
        WindowStartupLocation="CenterScreen"
        Title="QC Management" Height="700" Width="1000"
        WindowState="Maximized"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        >
    <Window.Resources>
        <!--// Text font style //-->
        <Style x:Key="font_style" TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="Fonts/Roboto-Light.ttf #Roboto"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="HorizontalAlignment"
                    Value="Left"/>
            <Setter Property="Foreground"
                    Value="Black"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=nav_pnl, Path=Width}" Value="55">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ElementName=nav_pnl, Path=Width}" Value="170">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!--// Tooltip Style Template //-->
        <Style TargetType="ToolTip" x:Key="tt_style">
            <Setter Property="Placement" Value="Right"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="auto"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
            <Setter Property="Background" Value="#4A5668"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Fonts/Roboto-Light.ttf #Roboto"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="PlacementRectangle" Value="50,0,0,0"/>
            <Setter Property="HorizontalOffset" Value="20"/>
            <Setter Property="VerticalOffset" Value="6"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedWindowCommand}" 
                                   CommandParameter="{Binding ElementName=mainWindow}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Name="SidebarColumn" Width="70"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="0,0,2,0"></ContentControl>

        <materialDesign:Card Grid.Column="0"       
              x:Name="nav_pnl" HorizontalAlignment="Left" Width="55" Background="LightGray">
            <StackPanel x:Name="st_pnl">
                <!--// Grid for the Menu Toggle Button //-->
                <Grid Height="90">
                    <!--// Menu title text //-->
                    <TextBlock Margin="0,0,0,42" Text="MENU" Foreground="Black" 
                               FontSize="22"
                               Background="Transparent"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" Name="menu">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=nav_pnl, Path=Width}" Value="55">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=nav_pnl, Path=Width}" Value="170">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!--// Toggle Button //-->
                    <ToggleButton x:Name="Tg_Btn" Grid.Column="0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="10,-20,0,0"
                                  Height="30"
                                  Width="30"
                                  BorderThickness="0"
                                  Checked="Tg_Btn_Checked"
                                  Unchecked="Tg_Btn_Unchecked"    
                                  Style="{StaticResource MaterialDesignHamburgerToggleButton}" >
                        <!--// Toggle Button - Checked, Unchecked events //-->
                        <ToggleButton.Triggers>
                            <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                <BeginStoryboard>
                                    <Storyboard x:Name="HideStackPanel">
                                        <DoubleAnimation    
                                                Storyboard.TargetName="nav_pnl"
                                                Storyboard.TargetProperty="Width"
                                                BeginTime="0:0:0"
                                                From="170" To="55"
                                                Duration="0:0:0.3"
                                                >
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="ToggleButton.Checked">
                                <BeginStoryboard>
                                    <Storyboard x:Name="ShowStackPanel">
                                        <DoubleAnimation    
                                                Storyboard.TargetName="nav_pnl"
                                                Storyboard.TargetProperty="Width"
                                                BeginTime="0:0:0"
                                                From="55" To="170"
                                                Duration="0:0:0.3"
                                                >
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ToggleButton.Triggers>
                    </ToggleButton>
                </Grid>
                <!--// ListView with menu list items //-->

                <ListView  x:Name="LV" Background="Transparent"  BorderBrush="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <!--// Home //-->
                    <ListViewItem 
                        Name="HomeItem"
                        HorizontalAlignment="Left" Margin="0,0,0,0" MouseEnter="ListViewItem_MouseEnter">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Selected">
                                <i:InvokeCommandAction Command="{Binding LoadHomePageCommand}" CommandParameter="{Binding ElementName=HomeItem}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <StackPanel Orientation="Horizontal" Width="170">
                            <materialDesign:PackIcon Kind="HomeOutline" Margin="5,0,0,0" Height="30" Width="40" />
                            <TextBlock Text="Home" Margin="5,0,0,0"  Style="{StaticResource font_style}">
                  
                            </TextBlock>
                        </StackPanel>
                        <!--// Tooltip //-->
                        <ListViewItem.ToolTip>
                            <ToolTip x:Name="tt_home" Content="Home" Style="{StaticResource tt_style}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>
                    
                    <!--// input result //-->
                    <ListViewItem HorizontalAlignment="Left" Margin="0,0,0,0" MouseEnter="ListViewItem_MouseEnter" >
                       
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Selected">
                                <i:InvokeCommandAction Command="{Binding LoadResultViewCommand}" CommandParameter="{Binding ElementName=HomeItem}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <StackPanel Orientation="Horizontal" Width="170">
                            <materialDesign:PackIcon Kind="PencilBoxMultiple" Margin="5,0,0,0" Height="30" Width="40"/>
                            <TextBlock Text="Nhập kết quả"  Margin="5,0,0,0" Style="{StaticResource font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip x:Name="tt_input" Content="Nhập kết quả" Style="{StaticResource tt_style}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>
                    
                    <!--// View Result //-->
                    <ListViewItem HorizontalAlignment="Left" Margin="0,0,0,0" MouseEnter="ListViewItem_MouseEnter" >

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Selected">
                                <i:InvokeCommandAction Command="{Binding LoadViewResultViewCommand}" CommandParameter="{Binding ElementName=HomeItem}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <StackPanel Orientation="Horizontal" Width="170">
                            <materialDesign:PackIcon Kind="CardSearchOutline" Margin="5,0,0,0" Height="30" Width="40"/>
                            <TextBlock Text="Xem kết quả"  Margin="5,0,0,0" Style="{StaticResource font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip x:Name="ViewReuslt" Content="Xem kết quả" Style="{StaticResource tt_style}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>

                    <!--// QC Infor //-->

                    <ListViewItem 
                         Visibility="{Binding Visibility1}"
                        HorizontalAlignment="Left" 
                                  Margin="0,0,0,0 " MouseEnter="ListViewItem_MouseEnter">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Selected">
                                <i:InvokeCommandAction Command="{Binding LoadQC_InformationViewCommand}" CommandParameter="{Binding ElementName=HomeItem}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        
                        <StackPanel Orientation="Horizontal" Width="170">
                            <materialDesign:PackIcon Kind="AlphaQBox" Height="30" Width="40" Margin="5,0,0,0"/>
                            <TextBlock Text="Thông tin" Margin="5,0,0,0" Style="{StaticResource font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip x:Name="tt_qcInfor" Content="Thông tin QC" Style="{StaticResource tt_style}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>

                    <!--// RangeQC //-->

                    <ListViewItem 
                         Visibility="{Binding Visibility1}"
                        HorizontalAlignment="Left" 
                                  Margin="0,0,0,0 " MouseEnter="ListViewItem_MouseEnter">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Selected">
                                <i:InvokeCommandAction Command="{Binding LoadQC_DetailViewCommand}" CommandParameter="{Binding ElementName=HomeItem}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <StackPanel Orientation="Horizontal" Width="170">
                            <materialDesign:PackIcon Kind="AlphaQBoxOutline" Height="30" Width="40" Margin="5,0,0,0"/>
                            <TextBlock Text="Range QC" Margin="5,0,0,0" Style="{StaticResource font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip x:Name="tt_range" Content="Range QC" Style="{StaticResource tt_style}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>
                    
                    
                    <!--// CAL //-->

                    <ListViewItem 
                         Visibility="{Binding Visibility1}"
                        HorizontalAlignment="Left" 
                                  Margin="0,0,0,0 " MouseEnter="ListViewItem_MouseEnter">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Selected">
                                <i:InvokeCommandAction Command="{Binding LoadCALViewCommand}" CommandParameter="{Binding ElementName=HomeItem}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <StackPanel Orientation="Horizontal" Width="170">
                            <materialDesign:PackIcon Kind="AlphaCBox" Height="30" Width="40" Margin="5,0,0,0"/>
                            <TextBlock Text="Thông tin Cal" Margin="5,0,0,0" Style="{StaticResource font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip x:Name="Cal_range" Content="Thông tin Cal" Style="{StaticResource tt_style}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>
            
                    <!--CAL Detail--> 
                    
                    <ListViewItem 
                         Visibility="{Binding Visibility1}"
                        HorizontalAlignment="Left" 
                                  Margin="0,0,0,0 " MouseEnter="ListViewItem_MouseEnter">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Selected">
                                <i:InvokeCommandAction Command="{Binding LoadCALDetailViewCommand}" CommandParameter="{Binding ElementName=HomeItem}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <StackPanel Orientation="Horizontal" Width="170">
                            <materialDesign:PackIcon Kind="AlphaCBoxOutline" Height="30" Width="40" Margin="5,0,0,0"/>
                            <TextBlock Text="Range CAL" Margin="5,0,0,0" Style="{StaticResource font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip x:Name="Cal_detail" Content="Range CAL" Style="{StaticResource tt_style}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>

                    <!--Test-->
                    <ListViewItem 
                         Visibility="{Binding Visibility1}"
                        HorizontalAlignment="Left" Margin="0,0,0,0" MouseEnter="ListViewItem_MouseEnter" >

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Selected">
                                <i:InvokeCommandAction Command="{Binding LoadTestViewCommand}" CommandParameter="{Binding ElementName=HomeItem}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <StackPanel Orientation="Horizontal" Width="170">
                            <materialDesign:PackIcon Kind="TestTube" Height="30" Width="40" Margin="5,0,0,0"/>
                            <TextBlock Text="Xét nghiệm" Margin="5,0,0,0" Style="{StaticResource font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip x:Name="tt_test" Content="Test" Style="{StaticResource tt_style}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>

                    <!--// Đơn vị tính //-->
                    <ListViewItem
                        Visibility="{Binding Visibility1}"
                        HorizontalAlignment="Left" Margin="0,0,0,0" 
                        MouseEnter="ListViewItem_MouseEnter" >
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Selected">
                                <i:InvokeCommandAction Command="{Binding LoadUnitViewCommand}" CommandParameter="{Binding ElementName=HomeItem}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <StackPanel Orientation="Horizontal" Width="170">
                            <materialDesign:PackIcon Kind="Unity" Height="30" Width="40" Margin="5,0,0,0"/>
                            <TextBlock Text="Đơn vị tính" Margin="5,0,0,0" Style="{StaticResource font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip x:Name="tt_unit" Content="Unit" Style="{StaticResource tt_style}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>

                    <!--Device-->
                    <ListViewItem 
                         Visibility="{Binding Visibility1}"
                        HorizontalAlignment="Left" Margin="0,0,0,0" MouseEnter="ListViewItem_MouseEnter" >

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Selected">
                                <i:InvokeCommandAction Command="{Binding LoadDeviceViewCommand}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <StackPanel Orientation="Horizontal" Width="170">
                            <materialDesign:PackIcon Kind="Devices" Height="30" Width="40" Margin="5,0,0,0"/>
                            <TextBlock Text="Thiết bị" Margin="5,0,0,0" Style="{StaticResource font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip x:Name="tt_device" Content="Device" Style="{StaticResource tt_style}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>

                    <!--// User //-->
                    <ListViewItem 
                         Visibility="{Binding Visibility2}"
                        HorizontalAlignment="Left" Margin="0,0,0,0" MouseEnter="ListViewItem_MouseEnter" >

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Selected">
                                <i:InvokeCommandAction Command="{Binding LoadUserViewCommand}" CommandParameter="{Binding ElementName=HomeItem}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <StackPanel Orientation="Horizontal" Width="170">
                            <materialDesign:PackIcon Kind="AccountTie" Margin="5,0,0,0" Height="30" Width="40"/>
                            <TextBlock Text="Người dùng"  Margin="5,0,0,0" Style="{StaticResource font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip x:Name="tt_user" Content="User" Style="{StaticResource tt_style}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>

                    <!--// User_role //-->
                    <ListViewItem 
                         Visibility="{Binding Visibility2}"
                        HorizontalAlignment="Left" Margin="0,0,0,0" MouseEnter="ListViewItem_MouseEnter" >

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Selected">
                                <i:InvokeCommandAction Command="{Binding LoadUserRoleViewCommand}" CommandParameter="{Binding ElementName=HomeItem}">
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <StackPanel Orientation="Horizontal" Width="170">
                            <materialDesign:PackIcon Kind="GoogleCirclesCommunities" Height="30" Width="40" Margin="5,0,0,0"/>
                            <TextBlock Text="Phân quyền" Margin="5,0,0,0" Style="{StaticResource font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip x:Name="tt_user_role" Content="User Role" Style="{StaticResource tt_style}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>
                    
                    <!--User-->

                    <ListViewItem HorizontalAlignment="Left" Margin="0,0,0,0" MouseEnter="ListViewItem_MouseEnter" >

                        <StackPanel Orientation="Horizontal" Width="170">
                            <materialDesign:PackIcon Kind="AccountTie" Height="30" Width="40" Margin="5,0,0,0"/>
                            <TextBlock Text="{Binding CurrentUser.DisplayName}" Margin="5,0,0,0" Style="{StaticResource font_style}"/>
                        </StackPanel>
                    </ListViewItem>
                    <!--// Listview items style template //-->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                                        <Border x:Name="Bd"
                                                    Height="50"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter Property="Background"
                                                            TargetName="Bd"
                                                            Value="#404D5B"/>
                                                <Setter Property="BorderBrush"
                                                            TargetName="Bd"
                                                            Value="#404D5B"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
