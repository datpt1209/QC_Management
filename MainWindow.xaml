<Window x:Class="QC_Management.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:QC_Management"
        mc:Ignorable="d"
        Name="mainWindow"
        DataContext="{StaticResource MainVM}"
        WindowStartupLocation="CenterScreen"
        Title="QC Management" Height="700" Width="1000"
        WindowState="Maximized"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        >
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- text style (labels show only when drawer open) -->
        <Style x:Key="font_style" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Fonts/Roboto-Light.ttf #Roboto"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="15"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=NavDrawer, Path=IsLeftDrawerOpen}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ElementName=NavDrawer, Path=IsLeftDrawerOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- tooltip style -->
        <Style TargetType="ToolTip" x:Key="tt_style">
            <Setter Property="Placement" Value="Right"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="auto"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
            <Setter Property="Background" Value="#4A5668"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Fonts/Roboto-Light.ttf #Roboto"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="PlacementRectangle" Value="50,0,0,0"/>
            <Setter Property="HorizontalOffset" Value="20"/>
            <Setter Property="VerticalOffset" Value="6"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedWindowCommand}" 
                                   CommandParameter="{Binding ElementName=mainWindow}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <!-- DrawerHost provides overlay; we wrap left content in a rounded Border for the 'curved card' look -->
    <materialDesign:DrawerHost x:Name="NavDrawer"
                               LeftDrawerCornerRadius="0 20 20 0"
                               OpenMode="Modal"
                               IsLeftDrawerOpen="{Binding ElementName=MenuToggleButton, Path=IsChecked}">

        <materialDesign:DrawerHost.LeftDrawerContent>
            <!-- rounded Border to produce curved right edge like screenshot -->
            <Border CornerRadius="0,20,20,0"
                    Background="White"
                    Margin="0"
                    SnapsToDevicePixels="True"
                    Width="320"
                    Effect="{DynamicResource MaterialDesignElevationShadowDepth4}">
                <DockPanel MinWidth="260" Background="Transparent">
                    <!-- Header -->
                    <DockPanel Margin="16" DockPanel.Dock="Top" LastChildFill="False">
                        <Border Width="44" Height="44" CornerRadius="8" Background="#FF5C9EFF" VerticalAlignment="Center">
                            <TextBlock Text="QC" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Margin="12,0,10,0"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="QC Management">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=NavDrawer, Path=IsLeftDrawerOpen}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ElementName=NavDrawer, Path=IsLeftDrawerOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button x:Name="MenuClose"
                                Width="44"
                                Height="44"
                                DockPanel.Dock="Right"
                                Click="MenuClose_Click"
                                Style="{StaticResource MaterialDesignIconForegroundButton}"
                                ToolTip="Close">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                        </Button>
                    </DockPanel>

                    <!-- Search -->
                    <TextBox x:Name="SearchBox"
                             Margin="16,0,16,8"
                             materialDesign:HintAssist.Hint="Search"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="8"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             DockPanel.Dock="Top"/>

                    <!-- Menu list — pill highlight + rounded corners; SelectionChanged auto-closes drawer -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListView x:Name="LV"
                                  Background="Transparent"
                                  BorderBrush="Transparent"
                                  SelectionChanged="LV_SelectionChanged"
                                  HorizontalContentAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <!-- Home -->
                            <ListViewItem Name="HomeItem" MouseEnter="ListViewItem_MouseEnter">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Selected">
                                        <i:InvokeCommandAction Command="{Binding LoadHomePageCommand}" CommandParameter="{Binding ElementName=HomeItem}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="0" Kind="HomeOutline" Margin="6,0,6,0" Height="22" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Home" Style="{StaticResource font_style}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="1" Margin="8,0,0,0" Foreground="#777" VerticalAlignment="Center"
                                               Visibility="{Binding ElementName=NavDrawer, Path=IsLeftDrawerOpen, Converter={StaticResource BoolToVis}}"/>
                                </Grid>

                                <ListViewItem.ToolTip>
                                    <ToolTip x:Name="tt_home" Content="Home" Style="{StaticResource tt_style}"/>
                                </ListViewItem.ToolTip>
                            </ListViewItem>

                            <!-- Nhập kết quả -->
                            <ListViewItem MouseEnter="ListViewItem_MouseEnter">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Selected">
                                        <i:InvokeCommandAction Command="{Binding LoadResultViewCommand}" CommandParameter="{Binding ElementName=HomeItem}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="0" Kind="PencilBoxMultiple" Margin="6,0,6,0" Height="22" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Nhập kết quả" Style="{StaticResource font_style}" VerticalAlignment="Center"/>
                                </Grid>

                                <ListViewItem.ToolTip>
                                    <ToolTip x:Name="tt_input" Content="Nhập kết quả" Style="{StaticResource tt_style}"/>
                                </ListViewItem.ToolTip>
                            </ListViewItem>

                            <!-- Xem kết quả -->
                            <ListViewItem MouseEnter="ListViewItem_MouseEnter">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Selected">
                                        <i:InvokeCommandAction Command="{Binding LoadViewResultViewCommand}" CommandParameter="{Binding ElementName=HomeItem}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="0" Kind="CardSearchOutline" Margin="6,0,6,0" Height="22" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Xem kết quả" Style="{StaticResource font_style}" VerticalAlignment="Center"/>
                                </Grid>

                                <ListViewItem.ToolTip>
                                    <ToolTip x:Name="ViewReuslt" Content="Xem kết quả" Style="{StaticResource tt_style}"/>
                                </ListViewItem.ToolTip>
                            </ListViewItem>

                            <!-- ListViewItem: Ngoại kiểm --><!--
                            <ListViewItem MouseEnter="ListViewItem_MouseEnter">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Selected">
                                        <i:InvokeCommandAction Command="{Binding LoadExternalControlEntryViewCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="0" Kind="Database" Margin="6,0,6,0" Height="22" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Ngoại kiểm" Style="{StaticResource font_style}" VerticalAlignment="Center"/>
                                </Grid>

                                <ListViewItem.ToolTip>
                                    <ToolTip Content="Nhập ngoại kiểm" Style="{StaticResource tt_style}"/>
                                </ListViewItem.ToolTip>
                            </ListViewItem>-->

                            <!-- QC Infor -->
                            <ListViewItem Visibility="{Binding Visibility1}" MouseEnter="ListViewItem_MouseEnter">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Selected">
                                        <i:InvokeCommandAction Command="{Binding LoadQC_InformationViewCommand}" CommandParameter="{Binding ElementName=HomeItem}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="0" Kind="AlphaQBox" Height="22" Width="28" Margin="6,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Thông tin QC" Style="{StaticResource font_style}" VerticalAlignment="Center"/>
                                </Grid>

                                <ListViewItem.ToolTip>
                                    <ToolTip x:Name="tt_qcInfor" Content="Thông tin QC" Style="{StaticResource tt_style}"/>
                                </ListViewItem.ToolTip>
                            </ListViewItem>

                            <!-- CAL -->
                            <ListViewItem Visibility="{Binding Visibility1}" MouseEnter="ListViewItem_MouseEnter">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Selected">
                                        <i:InvokeCommandAction Command="{Binding LoadCALViewCommand}" CommandParameter="{Binding ElementName=HomeItem}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="0" Kind="AlphaCBox" Height="22" Width="28" Margin="6,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Thông tin Cal" Style="{StaticResource font_style}" VerticalAlignment="Center"/>
                                </Grid>

                                <ListViewItem.ToolTip>
                                    <ToolTip x:Name="Cal_range" Content="Thông tin Cal" Style="{StaticResource tt_style}"/>
                                </ListViewItem.ToolTip>
                            </ListViewItem>

                            <!-- Test -->
                            <ListViewItem Visibility="{Binding Visibility1}" MouseEnter="ListViewItem_MouseEnter">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Selected">
                                        <i:InvokeCommandAction Command="{Binding LoadTestViewCommand}" CommandParameter="{Binding ElementName=HomeItem}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="0" Kind="TestTube" Height="22" Width="28" Margin="6,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Xét nghiệm" Style="{StaticResource font_style}" VerticalAlignment="Center"/>
                                </Grid>

                                <ListViewItem.ToolTip>
                                    <ToolTip x:Name="tt_test" Content="Test" Style="{StaticResource tt_style}"/>
                                </ListViewItem.ToolTip>
                            </ListViewItem>

                            <!-- Unit -->
                            <ListViewItem Visibility="{Binding Visibility1}" MouseEnter="ListViewItem_MouseEnter">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Selected">
                                        <i:InvokeCommandAction Command="{Binding LoadUnitViewCommand}" CommandParameter="{Binding ElementName=HomeItem}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="0" Kind="Unity" Height="22" Width="28" Margin="6,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Đơn vị tính" Style="{StaticResource font_style}" VerticalAlignment="Center"/>
                                </Grid>

                                <ListViewItem.ToolTip>
                                    <ToolTip x:Name="tt_unit" Content="Unit" Style="{StaticResource tt_style}"/>
                                </ListViewItem.ToolTip>
                            </ListViewItem>

                            <!-- Device -->
                            <ListViewItem Visibility="{Binding Visibility1}" MouseEnter="ListViewItem_MouseEnter">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Selected">
                                        <i:InvokeCommandAction Command="{Binding LoadDeviceViewCommand}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="0" Kind="Devices" Height="22" Width="28" Margin="6,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Thiết bị" Style="{StaticResource font_style}" VerticalAlignment="Center"/>
                                </Grid>

                                <ListViewItem.ToolTip>
                                    <ToolTip x:Name="tt_device" Content="Device" Style="{StaticResource tt_style}"/>
                                </ListViewItem.ToolTip>
                            </ListViewItem>

                            <!-- User -->
                            <ListViewItem Visibility="{Binding Visibility2}" MouseEnter="ListViewItem_MouseEnter">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Selected">
                                        <i:InvokeCommandAction Command="{Binding LoadUserViewCommand}" CommandParameter="{Binding ElementName=HomeItem}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="0" Kind="AccountTie" Height="22" Width="28" Margin="6,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Người dùng" Style="{StaticResource font_style}" VerticalAlignment="Center"/>
                                </Grid>

                                <ListViewItem.ToolTip>
                                    <ToolTip x:Name="tt_user" Content="User" Style="{StaticResource tt_style}"/>
                                </ListViewItem.ToolTip>
                            </ListViewItem>

                            <!-- User role -->
                            <ListViewItem Visibility="{Binding Visibility2}" MouseEnter="ListViewItem_MouseEnter">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Selected">
                                        <i:InvokeCommandAction Command="{Binding LoadUserRoleViewCommand}" CommandParameter="{Binding ElementName=HomeItem}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="0" Kind="GoogleCirclesCommunities" Height="22" Width="28" Margin="6,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Phân quyền" Style="{StaticResource font_style}" VerticalAlignment="Center"/>
                                </Grid>

                                <ListViewItem.ToolTip>
                                    <ToolTip x:Name="tt_user_role" Content="User Role" Style="{StaticResource tt_style}"/>
                                </ListViewItem.ToolTip>
                            </ListViewItem>

                            <!-- Current user -->
                            <ListViewItem MouseEnter="ListViewItem_MouseEnter">
                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="0" Kind="AccountTie" Height="22" Width="28" Margin="6,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentUser.DisplayName}" Style="{StaticResource font_style}" VerticalAlignment="Center"/>
                                </Grid>
                            </ListViewItem>

                            <!-- ItemContainerStyle: rounded pill highlight that fills full width -->
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="6,4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="Bd" Background="Transparent" SnapsToDevicePixels="True" Padding="0">
                                                    <Grid>
                                                        <!-- larger/more-contrasting highlight for hover/selected -->
                                                        <Border x:Name="Highlight"
                                                                Background="Transparent"
                                                                CornerRadius="26"
                                                                Margin="2"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Center"/>
                                                        <ContentPresenter x:Name="contentPresenter"
                                                                          HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center"
                                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                    </Grid>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                    <!-- Hover: stronger color and pointer -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Highlight" Property="Background" Value="#FFF1F6FF"/> <!-- adjust color as needed -->
                                                        <Setter TargetName="Bd" Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Foreground" Value="#222222"/>
                                                    </Trigger>

                                                    <!-- Selected: clearly distinct -->
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Highlight" Property="Background" Value="#FFE7D8FF"/>
                                                        <Setter Property="Foreground" Value="#4A2463"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </materialDesign:DrawerHost.LeftDrawerContent>

        <!-- Main content area with ContentWrapper Border to receive corner radius when drawer opens -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Compact rail (icons only) -->
            <materialDesign:Card Grid.Column="0" Background="Transparent" Padding="6" Margin="6">
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" >
                    <ToggleButton x:Name="MenuToggleButton"
                                  Margin="0,8,0,8"
                                  Height="36"
                                  Width="36"
                                  BorderThickness="0"
                                  Style="{StaticResource MaterialDesignHamburgerToggleButton}" />

                    <!-- Compact icon stack (replace the existing CompactIcons StackPanel) -->
                    <StackPanel x:Name="CompactIcons" Orientation="Vertical" Margin="0,8,0,0" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=NavDrawer, Path=IsLeftDrawerOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Home -->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding LoadHomePageCommand}"
                                ToolTipService.ToolTip="Home"
                                Margin="0,6">
                            <materialDesign:PackIcon Kind="HomeOutline" Width="24" Height="24"/>
                        </Button>

                        <!-- Nhập kết quả -->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding LoadResultViewCommand}"
                                ToolTipService.ToolTip="Nhập kết quả"
                                Margin="0,6">
                            <materialDesign:PackIcon Kind="PencilBoxMultiple" Width="24" Height="24"/>
                        </Button>

                        <!-- Xem kết quả -->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding LoadViewResultViewCommand}"
                                ToolTipService.ToolTip="Xem kết quả"
                                Margin="0,6">
                            <materialDesign:PackIcon Kind="CardSearchOutline" Width="24" Height="24"/>
                        </Button>

                        <!-- Ngoại kiểm - Kết quả-->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
         Command="{Binding LoadExternalResultViewCommand}"
         ToolTipService.ToolTip="Ngoại kiểm - Kết quả"
         Margin="0,6">
                            <materialDesign:PackIcon Kind="Database" Width="24" Height="24"/>
                        </Button>

                        <!-- NEW: Quản lý Lỗi / Khắc phục (Incident Management) -->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding LoadIncidentManagementViewCommand}"
                                ToolTipService.ToolTip="Quản lý Lỗi/Khắc phục"
                                Margin="0,6">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="24" Height="24"/>
                        </Button>

                        <!-- QC Info -->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding LoadQC_InformationViewCommand}"
                                ToolTipService.ToolTip="Thông tin QC"
                                Margin="0,6"
                                Visibility="{Binding Visibility1}">
                            <materialDesign:PackIcon Kind="AlphaQBox" Width="24" Height="24"/>
                        </Button>

                        <!-- CAL Info -->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding LoadCALViewCommand}"
                                ToolTipService.ToolTip="Thông tin Calib"
                                Margin="0,6"
                                Visibility="{Binding Visibility1}">
                            <materialDesign:PackIcon Kind="AlphaCBox" Width="24" Height="24"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- NEW: wrap the content so we can round its top-left corner when drawer opens -->
            <Border x:Name="ContentWrapper"
                    Grid.Column="1"
                    Background="{DynamicResource MaterialDesignPaper}"
                    SnapsToDevicePixels="True"
                    Padding="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=NavDrawer, Path=IsLeftDrawerOpen}" Value="True">
                                <!-- top-left corner rounded to match drawer's curved edge -->
                                <Setter Property="CornerRadius" Value="20,0,0,0"/>
                                <!-- optional subtle elevation when drawer open -->
                                <Setter Property="Effect" Value="{DynamicResource MaterialDesignElevationShadowDepth1}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <!-- original main content -->
                <ContentControl Content="{Binding CurrentView}" Margin="0,0,2,0"/>
            </Border>
        </Grid>
    </materialDesign:DrawerHost>
</Window>