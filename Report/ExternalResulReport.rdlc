												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>Tên thông số</Value>
														</TextRun>
													</TextRuns>
													<Style/>
												</Paragraph>
											</Paragraphs>
										</Textbox>
									</CellContents>
								</TablixCell>
								<TablixCell>
									<CellContents>
										<Textbox Name="H_Unit">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>Đơn vị</Value>
														</TextRun>
													</TextRuns>
													<Style/>
