								<TablixCell>
									<CellContents>
										<Textbox Name="H_Z">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>z-score</Value>
														</TextRun>
													</TextRuns>
													<Style/>
												</Paragraph>
											</Paragraphs>
										</Textbox>
									</CellContents>
								</TablixCell>
								<TablixCell>
									<CellContents>
										<Textbox Name="H_Status">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>Đánh giá</Value>
														</TextRun>
													</TextRuns>
													<Style/>
												</Paragraph>
											</Paragraphs>
										</Textbox>
