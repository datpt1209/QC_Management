									<CellContents>
										<Textbox Name="H_Notes">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>Ghi chú</Value>
														</TextRun>
													</TextRuns>
													<Style/>
												</Paragraph>
											</Paragraphs>
										</Textbox>
									</CellContents>
								</TablixCell>
							</TablixCells>
						</TablixRow>

						<!-- data row -->
						<TablixRow>
							<Height>0.26in</Height>
							<TablixCells>
								<TablixCell>
									<CellContents>
										<Textbox Name="D_STT">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>=RowNumber(Nothing)</Value>
														</TextRun>
													</TextRuns>
													<Style/>
												</Paragraph>
											</Paragraphs>
										</Textbox>
									</CellContents>
