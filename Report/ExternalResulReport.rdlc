<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
	<AutoRefresh>0</AutoRefresh>
	<DataSources>
		<DataSource Name="dsResult">
			<ConnectionProperties>
				<DataProvider>System.Data.DataSet</DataProvider>
				<ConnectString />
			</ConnectionProperties>
			<rd:DataSourceID>2d7e7d55-1a8b-4f0c-9f2b-0f5a3b9c1a2b</rd:DataSourceID>
		</DataSource>
	</DataSources>

	<DataSets>
		<DataSet Name="dsResult">
			<Fields>
				<Field Name="ProgramName">
					<DataField>ProgramName</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="Batch">
					<DataField>Batch</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="DateSent">
					<DataField>DateSent</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="ReceivedAt">
					<DataField>ReceivedAt</DataField>
					<rd:TypeName>System.DateTime</rd:TypeName>
				</Field>
				<Field Name="Sample">
					<DataField>Sample</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="DeviceName">
					<DataField>DeviceName</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="TestName">
					<DataField>TestName</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="Unit">
					<DataField>Unit</DataField>
					<rd:TypeName>System.String</rd:TypeName>
