					</TablixMembers>
				</TablixColumnHierarchy>

				<!-- dataset binding -->
				<DataSetName>dsResult</DataSetName>

				<!-- simple grouping by DeviceName to show device blocks -->
				<TablixRowHierarchy>
					<TablixMembers>
						<TablixMember>
							<Group Name="DeviceGroup">
								<GroupExpressions>
									<GroupExpression>=Fields!DeviceName.Value</GroupExpression>
								</GroupExpressions>
							</Group>
							<TablixMembers>
								<TablixMember>
									<TablixMembers>
