													<TextRuns>
														<TextRun>
															<Value>=Fields!SigmaP.Value</Value>
														</TextRun>
													</TextRuns>
													<Style/>
												</Paragraph>
											</Paragraphs>
										</Textbox>
									</CellContents>
								</TablixCell>
								<TablixCell>
									<CellContents>
										<Textbox Name="D_Z">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>=IIf(IsNothing(Fields!ZScore.Value), "", FormatNumber(Fields!ZScore.Value, 3))</Value>
														</TextRun>
													</TextRuns>
													<Style/>
												</Paragraph>
											</Paragraphs>
										</Textbox>
									</CellContents>
