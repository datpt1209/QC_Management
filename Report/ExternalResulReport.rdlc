					<rd:TypeName>System.Double</rd:TypeName>
				</Field>
				<Field Name="Status">
					<DataField>Status</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="Notes">
					<DataField>Notes</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
			</Fields>
			<Query>
				<DataSourceName>dsResult</DataSourceName>
				<CommandText />
			</Query>
		</DataSet>
	</DataSets>

	<Body>
		<ReportItems>
			<!-- Title -->
			<Textbox Name="Title">
				<CanGrow>true</CanGrow>
				<KeepTogether>true</KeepTogether>
				<Paragraphs>
					<Paragraph>
						<TextRuns>
							<TextRun>
								<Value>PHIẾU THEO DÕI VÀ ĐÁNH GIÁ KẾT QUẢ NGOẠI KIỂM TRA</Value>
								<Style>
									<FontSize>14pt</FontSize>
									<FontWeight>Bold</FontWeight>
								</Style>
							</TextRun>
						</TextRuns>
						<Style/>
					</Paragraph>
				</Paragraphs>
				<Top>0.1in</Top>
				<Left>0in</Left>
				<Width>7.5in</Width>
				<Height>0.4in</Height>
				<ZIndex>2</ZIndex>
				<Style>
					<TextAlign>Center</TextAlign>
				</Style>
			</Textbox>

			<!-- Program header table -->
			<Tablix Name="HeaderTable">
				<TablixBody>
					<TablixColumns>
						<TablixColumn>
							<Width>3.75in</Width>
						</TablixColumn>
						<TablixColumn>
							<Width>3.75in</Width>
						</TablixColumn>
					</TablixColumns>

					<TablixRows>
						<TablixRow>
							<Height>0.25in</Height>
							<TablixCells>
								<TablixCell>
									<CellContents>
										<Textbox Name="ProgramNameBox">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>=Fields!ProgramName.Value</Value>
															<Style>
																<FontSize>10pt</FontSize>
															</Style>
														</TextRun>
													</TextRuns>
													<Style/>
												</Paragraph>
											</Paragraphs>
										</Textbox>
									</CellContents>
								</TablixCell>
								<TablixCell>
									<CellContents>
										<Textbox Name="BatchBox">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>="Đợt: " &amp; Fields!Batch.Value</Value>
															<Style>
																<FontSize>10pt</FontSize>
															</Style>
														</TextRun>
													</TextRuns>
													<Style/>
												</Paragraph>
											</Paragraphs>
										</Textbox>
									</CellContents>
								</TablixCell>
							</TablixCells>
						</TablixRow>
						<TablixRow>
							<Height>0.25in</Height>
							<TablixCells>
								<TablixCell>
									<CellContents>
										<Textbox Name="DateSentBox">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>="Ngày gửi kết quả: " &amp; Fields!DateSent.Value</Value>
														</TextRun>
													</TextRuns>
													<Style/>
												</Paragraph>
											</Paragraphs>
										</Textbox>
									</CellContents>
								</TablixCell>
								<TablixCell>
									<CellContents>
										<Textbox Name="ReceivedAtBox">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>="Ngày nhận kết quả: " &amp; Format(Fields!ReceivedAt.Value, "dd/MM/yyyy")</Value>
														</TextRun>
													</TextRuns>
													<Style/>
												</Paragraph>
											</Paragraphs>
										</Textbox>
									</CellContents>
								</TablixCell>
							</TablixCells>
						</TablixRow>
					</TablixRows>
				</TablixBody>

				<TablixColumnHierarchy>
					<TablixMembers>
						<TablixMember/>
						<TablixMember/>
					</TablixMembers>
				</TablixColumnHierarchy>
				<TablixRowHierarchy>
					<TablixMembers>
						<TablixMember/>
						<TablixMember/>
					</TablixMembers>
				</TablixRowHierarchy>

				<Top>0.6in</Top>
				<Left>0in</Left>
				<Height>0.6in</Height>
				<Width>7.5in</Width>
			</Tablix>

			<!-- Main table (grouped by DeviceName) -->
			<Tablix Name="ResultsTable">
				<TablixBody>
					<TablixColumns>
						<TablixColumn>
							<Width>0.4in</Width>
						</TablixColumn>
						<TablixColumn>
							<Width>1.8in</Width>
						</TablixColumn>
						<TablixColumn>
							<Width>0.6in</Width>
