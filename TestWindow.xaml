<Window x:Class="QC_Management.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QC_Management" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        mc:Ignorable="d"
        Title="TestWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Margin="0,0,0,-14">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <!--các element binding từ selected item-->
            <materialDesign:Card Grid.Row="0" Margin="5">
                <WrapPanel Margin="0 0 0 10">
                    <ComboBox
                        Margin="5 5 15 -14"
                        ItemsSource="{Binding Category}"
                        DisplayMemberPath="DisplayName"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Loại sản phẩm"
                        materialDesign:HintAssist.HintOpacity=".26"
                        IsEditable="True">
               
                    </ComboBox>
                    <TextBox VerticalAlignment="Top" HorizontalAlignment="Stretch"
                             materialDesign:HintAssist.Hint="Tên sản phẩm"
                             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="5 5 15 5"
                             AcceptsReturn="True"
                             IsEnabled="{Binding Path=IsChecked, ElementName=MaterialDesignFilledTextBoxEnabledComboBox}"
                             Style="{StaticResource MaterialDesignFilledTextBox}"
                             TextWrapping="Wrap" />
                    <ComboBox 
                        Margin="5 5 15 -14"
                        ItemsSource="{Binding Unit}"
                        DisplayMemberPath="DisplayName"
                        SelectedItem="{Binding SelectedUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Đơn vị tính"
                        materialDesign:HintAssist.HintOpacity=".26"
                        IsEditable="True"/>
                    <ComboBox 
                        Margin="5 5 15 -14"
                        ItemsSource="{Binding Suplier}"
                        DisplayMemberPath="DisplayName"
                        SelectedItem="{Binding SelectedSuplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:ComboBoxAssist.MaxLength="2"
                        materialDesign:HintAssist.Hint="Supier"
                        materialDesign:HintAssist.HintOpacity=".26"
                        IsEditable="True"/>
                    <TextBox VerticalAlignment="Top"
                             materialDesign:HintAssist.Hint="Giá nhâp"
                             Margin="5 5 15 5"
                             Text="{Binding InputPrice, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             IsEnabled="{Binding IsChecked, ElementName=MaterialDesignFilledTextBoxEnabledComboBox}"
                             Style="{StaticResource MaterialDesignFilledTextBox}"
                             TextWrapping="Wrap"  />
                    <TextBox VerticalAlignment="Top"
                             materialDesign:HintAssist.Hint="Giá xuất"
                             Margin="5 5 15 5"
                             Text="{Binding OutputPrice, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             IsEnabled="{Binding IsChecked, ElementName=MaterialDesignFilledTextBoxEnabledComboBox}"
                             Style="{StaticResource MaterialDesignFilledTextBox}"
                             TextWrapping="Wrap"  />

                    <Image Height="50" Width="60"
                           Source="{Binding ImageString, Converter={StaticResource absoluteConverter}}"
                           d:Source="/Image/4.png">

                    </Image>
                    <Button x:Name="btImange" Content="Chọn hình" Margin="5" Width="100"></Button>

                </WrapPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="1" Margin="5">
                <WrapPanel>
                    <Button Command="{Binding AddCommand}" Content="Thêm" Margin="5" Width="100"></Button>
                    <Button Command="{Binding DeleteCommand}" Content="Xóa" Margin="5" Width="100"></Button>
                    <Button Command="{Binding EditCommand}" Content="Sửa" Margin="5" Width="100"></Button>
                </WrapPanel>

            </materialDesign:Card>

            <materialDesign:Card Grid.Row="2" Margin="5" VerticalAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListView Name="productsListView"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              HorizontalAlignment="Stretch" VerticalAlignment="Top" 
                              ItemsSource="{Binding List}"
                              SelectedItem="{Binding SelectedItem}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Width="200" Height="160">
                                    <Image Width="80" Height="80" RenderOptions.BitmapScalingMode="HighQuality" Margin="3" 
                                           Source="{Binding ImageString, Converter={StaticResource absoluteConverter}}"/>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Height="20" TextAlignment="Center"></TextBlock>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{Binding IdSuplierNavigation.DisplayName}" TextAlignment="Center" />
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Binding OutputPrice}" TextAlignment="Center"/>
                                                <TextBlock Text="{Binding Count}" TextAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
